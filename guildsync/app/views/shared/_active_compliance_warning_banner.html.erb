<% warning = active_ip_compliance_warning %>
<% if warning %>
  <div class="mb-4 rounded-lg border border-red-600/80 bg-red-950/60 px-4 py-3 text-sm text-red-200">
    <div class="font-semibold text-red-100"><%= t("compliance.ip_conflict.banner_title") %></div>
    <div class="mt-1"><%= warning.message %></div>
  </div>
<% end %>
