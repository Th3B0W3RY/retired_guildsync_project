<!DOCTYPE html>
<% use_inter_marketing_fonts = (controller_name == "home" && action_name == "landing") ||
                                 (controller_name == "homepage_features" && action_name == "show") ||
                                 (controller_name == "roadmap" && %w[index show].include?(action_name)) ||
                                 controller_name == "account_creation" ||
                                 (user_signed_in? && mfa_verified_for_session?) %>
<% use_fontawesome_free_css = (controller_name == "home" && action_name == "landing") ||
                                controller_path.start_with?("admin/") %>
<html class="theme-dark dark" lang="<%= I18n.locale %>">
  <head>
    <title><% if content_for?(:page_title) %><%= yield :page_title %><% else %><%= t("app_name") %><% end %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="csrf-token" content="<%= form_authenticity_token %>">

    <%= favicon_link_tag "favicon/favicon-32x32.png", sizes: "32x32", type: "image/png" %>
    <%= favicon_link_tag "favicon/apple-touch-icon-180x180.png", rel: "apple-touch-icon", sizes: "180x180", type: "image/png" %>

    <% if use_inter_marketing_fonts %>
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <% end %>
    <% if use_fontawesome_free_css %>
      <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <% end %>
    <%= yield :head if content_for?(:head) %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

  <% sessions_sign_in_shell = controller_name == "sessions" && %w[new create].include?(action_name) %>
  <%# MFA step-up pages: never use member sidebar / ml-72 — Discord users are "session MFA OK" in the helper but must still see an isolated shell here %>
  <% mfa_flow_shell = %w[mfa_verification mfa_setup].include?(controller_name) %>
  <% account_creation_shell = controller_name == "account_creation" %>
  <% auth_gate_shell = sessions_sign_in_shell || mfa_flow_shell || account_creation_shell %>
  <% home_landing_shell = controller_name == "home" && action_name == "landing" %>
  <% homepage_feature_public_shell = controller_name == "homepage_features" && action_name == "show" %>
  <% marketing_landing_width_shell = home_landing_shell || homepage_feature_public_shell %>
  <% pricing_public_shell = controller_name == "pricing" && action_name == "public_pricing" %>
  <% roadmap_guest_shell = controller_name == "roadmap" && %w[index show].include?(action_name) && !user_signed_in? %>
  <%# Signed-out marketing shells: same nav track (width + padding) and chrome on /, /login, /pricing, /roadmap (guest), MFA step-up %>
  <% marketing_guest_shell = sessions_sign_in_shell || home_landing_shell || homepage_feature_public_shell || pricing_public_shell || roadmap_guest_shell || mfa_flow_shell || account_creation_shell %>
  <%# Admin credential gate: member may be signed in; do not show member sidebar / full app chrome on /admin/login %>
  <% admin_sessions_shell = controller_path == "admin/sessions" && %w[new create].include?(action_name) %>
  <% member_app_layout_chrome = user_signed_in? && mfa_verified_for_session? && !admin_sessions_shell && !mfa_flow_shell %>
  <% signed_in_app_shell = member_app_layout_chrome && !marketing_guest_shell %>
  <%# Figma / roadmap guest bar: dark glass strip + white/5 rule — all marketing + auth shells share this. %>
  <% marketing_top_strip_class = "w-[100vw] max-w-[100vw] ml-[calc(50%-50vw)] shrink-0 border-b border-white/5 bg-[rgba(2,6,24,0.88)]" %>
  <%# Same horizontal track as home (guild-sync.net): one max width for all signed-out marketing nav rows. %>
  <% marketing_nav_max_class = "max-w-[1680px]" %>
  <%# min-height + wrap so logo row and CTA row can stack on very narrow viewports (home landing, pricing, etc.). %>
  <% marketing_nav_inner_class = "mx-auto flex min-h-14 w-full flex-wrap items-center justify-between gap-x-4 gap-y-3 #{marketing_nav_max_class} px-4 py-2 md:h-16 md:px-6 md:py-0" %>
  <% main_column_outer = if signed_in_app_shell
        "mx-auto w-full max-w-none overflow-visible px-0 pt-0 pb-6"
      else
        "container mx-auto #{marketing_guest_shell ? 'px-4 md:px-6' : 'px-4'} overflow-visible"
      end %>
  <% main_column_inner = if auth_gate_shell
        "max-w-7xl pt-0 pb-6 flex-1 flex flex-col min-h-0"
      elsif marketing_landing_width_shell
        "max-w-[1680px] pt-0 pb-6 flex-1 flex flex-col min-h-0"
      elsif pricing_public_shell
        "max-w-[1200px] pt-0 pb-6 flex-1 flex flex-col min-h-0"
      elsif roadmap_guest_shell
        "max-w-[1200px] pt-0 pb-6 flex-1 flex flex-col min-h-0"
      elsif signed_in_app_shell
        ""
      else
        "max-w-7xl pt-0 pb-6"
      end %>
  <% nav_logo_class = "text-xl font-bold text-theme-accent hover:text-dark-accent-hover transition-colors" %>
  <%# Figma node 56:772 RoadmapPage — nav links + Sign In %>
  <%# Top bar: same line-height, no wrap — matches Pricing beside GuildSync wordmark. %>
  <% roadmap_guest_nav_link_class = "inline-flex min-w-0 shrink items-center text-[#CAD5E2] text-base font-normal leading-6 whitespace-normal lg:whitespace-nowrap hover:text-white transition-colors" %>
  <% roadmap_guest_sign_in_class = "inline-flex h-9 min-h-9 w-full min-w-0 items-center justify-center rounded-lg bg-theme-brand-gradient px-4 text-base font-medium text-white hover:opacity-95 transition-opacity md:w-auto" %>
  <% guest_nav_link_class = "text-theme-secondary hover:text-theme-accent transition-colors" %>
  <% guest_lang_btn_class = "px-3 py-2 text-sm bg-theme-primary border border-theme-primary rounded-lg text-theme-secondary hover:text-theme-primary hover:border-theme-accent transition-colors flex items-center gap-1.5" %>
  <% guest_lang_menu_class = "hidden absolute right-0 mt-2 w-44 bg-theme-card border border-theme-primary rounded-lg shadow-xl z-50" %>
  <% guest_sign_in_class = "inline-flex items-center justify-center min-h-12 px-6 rounded-lg bg-theme-accent text-white font-semibold text-base hover:bg-theme-accent-hover transition-colors" %>
  <body class="bg-theme-primary text-theme-primary min-h-screen font-sans antialiased">
    <div class="relative min-h-screen <%= if auth_gate_shell
          'flex flex-col overflow-x-hidden bg-[linear-gradient(135deg,#020618_0%,#0F172B_50%,#020618_100%)]'
        elsif marketing_landing_width_shell
          'flex flex-col overflow-x-hidden bg-[linear-gradient(135deg,#020618_0%,#0F172B_50%,#020618_100%)]'
        elsif pricing_public_shell
          'flex flex-col overflow-x-hidden bg-[linear-gradient(135deg,#020618_0%,#0F172B_50%,#020618_100%)]'
        elsif roadmap_guest_shell
          'flex flex-col overflow-x-hidden bg-[linear-gradient(161.544deg,#020618_7.73%,#0F172B_50%,#020618_92.27%)]'
        elsif signed_in_app_shell
          'overflow-visible bg-[linear-gradient(135deg,#020618_0%,#0F172B_50%,#020618_100%)] font-[family-name:Inter,ui-sans-serif,system-ui,sans-serif]'
        else
          'overflow-visible bg-[linear-gradient(135deg,#020618_0%,#0F172B_50%,#020618_100%)] font-[family-name:Inter,ui-sans-serif,system-ui,sans-serif]'
        end %>"<% if member_app_layout_chrome %> data-controller="mobile-shell"<% end %>>
      <% unless controller_path.start_with?("admin") %>
        <%= render "shared/ambient_theme_background" %>
      <% end %>
      <% if member_app_layout_chrome %>
        <div data-mobile-shell-target="backdrop"
             data-action="click->mobile-shell#close"
             aria-hidden="true"
             class="fixed inset-0 z-[45] hidden bg-black/60 lg:hidden"></div>
        <div id="desktop-sidebar-panel"
             data-mobile-shell-target="panel"
             class="fixed top-0 left-0 z-[50] flex h-full min-h-0 w-[min(18rem,100vw)] max-w-full -translate-x-full flex-col transform shadow-xl transition-transform duration-200 ease-out lg:translate-x-0">
          <%= render "shared/sidebar", sidebar_fixed: false %>
        </div>
      <% end %>
      
      <!-- Main Content Wrapper (fixed left margin for sidebar when logged in) -->
      <div class="main-content-wrapper overflow-visible <%= 'ml-0 lg:ml-72' if member_app_layout_chrome %> <%= 'flex-1 flex flex-col min-h-0' if auth_gate_shell || marketing_landing_width_shell || pricing_public_shell || roadmap_guest_shell %>">
        <div class="<%= [main_column_outer, main_column_inner].compact_blank.join(' ') %>">
          <%# Sign-in / MFA step-up shell: full-width top bar; inner row stays max-w-7xl (matches container). %>
          <% if auth_gate_shell %>
            <div class="<%= marketing_top_strip_class %>">
              <div class="<%= marketing_nav_inner_class %>">
          <% elsif marketing_landing_width_shell %>
            <div class="<%= marketing_top_strip_class %>">
              <div class="<%= marketing_nav_inner_class %>">
          <% elsif pricing_public_shell %>
            <div class="<%= marketing_top_strip_class %>">
              <div class="<%= marketing_nav_inner_class %>">
          <% elsif roadmap_guest_shell %>
            <div class="<%= marketing_top_strip_class %>">
              <div class="<%= marketing_nav_inner_class %>">
          <% end %>
        <nav class="<%= if auth_gate_shell || marketing_landing_width_shell
              'border-0 shadow-none bg-transparent rounded-none mb-0 px-0 py-0'
            elsif pricing_public_shell || roadmap_guest_shell
              'border-0 shadow-none bg-transparent rounded-none mb-0 px-0 py-0'
            elsif signed_in_app_shell
              'border-0 shadow-none bg-transparent rounded-none mb-0 px-0 py-0'
            else
              'mb-6 border-0 border-b border-white/5 bg-[rgba(2,6,24,0.88)] shadow-none rounded-none px-6 py-3'
            end %> relative z-[999999] overflow-visible select-none cursor-default [&_input]:select-text [&_input]:cursor-text">
          <% if signed_in_app_shell %>
            <%= render "shared/signed_in_top_bar" %>
          <% else %>
          <% show_guest_beta_banner = !user_signed_in? && !controller_path.start_with?("admin") %>
          <div class="relative flex w-full flex-col gap-3 md:min-h-14 md:flex-row md:flex-wrap md:items-center md:justify-between md:gap-x-4 md:gap-y-2">
            <div class="relative z-[11] flex min-w-0 w-full flex-1 flex-wrap items-center gap-x-4 gap-y-2 md:w-auto md:gap-6">
              <% if member_app_layout_chrome %>
                <button type="button"
                        class="shrink-0 rounded-lg border border-white/10 p-2 text-slate-200 hover:bg-white/5 lg:hidden"
                        data-action="click->mobile-shell#toggle"
                        aria-controls="desktop-sidebar-panel"
                        aria-label="<%= t('sidebar.navigation') %>">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                  </svg>
                </button>
              <% end %>
              <% if marketing_guest_shell || (respond_to?(:admin_user?, true) && admin_user?) %>
                <%= link_to root_path, class: "flex shrink-0 items-center gap-2" do %>
                  <span class="flex h-8 w-8 items-center justify-center rounded-[10px] bg-gradient-to-br from-[#615FFF] to-[#9810FA] text-sm font-bold leading-5 text-white">GS</span>
                  <span class="bg-gradient-to-r from-[#7C86FF] to-[#C27AFF] bg-clip-text text-lg font-semibold leading-7 text-transparent"><%= t("app_name") %></span>
                <% end %>
              <% else %>
                <%= link_to root_path, class: nav_logo_class do %>
                  <%= t("app_name") %>
                <% end %>
              <% end %>
              <% if admin_sessions_shell && user_signed_in? && mfa_verified_for_session? %>
                <%= link_to t('layouts.application.nav.back_to_member_dashboard'), member_dashboard_path, class: "text-theme-secondary hover:text-theme-accent transition-colors" %>
              <% end %>
              <% if member_app_layout_chrome %>
                <%= link_to t('layouts.application.nav.upgrade_plan'), upgrade_pricing_path, class: "text-theme-secondary hover:text-theme-accent transition-colors" %>
              <% elsif mfa_flow_shell && user_signed_in? %>
                <%# MFA step-up: no product nav — avoid “dashboard” feel before verification %>
              <% else %>
                <%= link_to t("layouts.application.nav.pricing"), pricing_path, class: marketing_guest_shell ? roadmap_guest_nav_link_class : guest_nav_link_class %>
                <%= link_to t("layouts.application.nav.roadmap"), roadmap_path, class: marketing_guest_shell ? roadmap_guest_nav_link_class : guest_nav_link_class %>
              <% end %>
            </div>
            <div class="relative z-[11] flex w-full shrink-0 flex-col gap-2 md:w-auto md:flex-row md:flex-wrap md:items-center md:justify-end md:gap-4">
              <% if member_app_layout_chrome %>
                <!-- Global Search Bar -->
                <div class="relative" data-controller="global-search">
                  <div class="relative">
                    <input type="text"
                           data-global-search-target="input"
                           data-action="input->global-search#onInput keydown->global-search#onKeydown focus->global-search#onFocus"
                           placeholder="<%= t('layouts.application.search.placeholder') %>"
                           class="w-64 px-4 py-2 pl-10 bg-theme-primary border border-theme-primary rounded-lg text-theme-primary placeholder-theme-secondary focus:outline-none focus:ring-2 focus:ring-theme-accent focus:border-transparent text-sm"
                           autocomplete="off">
                    <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-theme-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                    <button type="button"
                            data-global-search-target="clearBtn"
                            data-action="click->global-search#clear"
                            class="hidden absolute right-3 top-1/2 transform -translate-y-1/2 text-theme-secondary hover:text-theme-primary">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                      </svg>
                    </button>
                  </div>
                  
                  <!-- Search Results Dropdown -->
                  <div data-global-search-target="results"
                       class="hidden absolute top-full left-0 right-0 z-50 mt-2 max-h-[min(24rem,calc(100vh-8rem))] overflow-y-auto rounded-lg border border-theme-primary bg-theme-card shadow-xl">
                    <div data-global-search-target="loading" class="hidden p-4 text-center text-theme-secondary">
                      <svg class="animate-spin h-5 w-5 mx-auto" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                      </svg>
                      <span class="text-sm mt-1 block"><%= t('layouts.application.search.searching') %></span>
                    </div>
                    <div data-global-search-target="empty" class="hidden p-4 text-center text-theme-secondary text-sm">
                      <%= t('layouts.application.search.no_results') %>
                    </div>
                    <div data-global-search-target="resultsList" class="divide-y divide-theme-primary">
                      <!-- Results will be inserted here -->
                    </div>
                  </div>
                </div>
                
                <span class="text-theme-secondary"><%= t('layouts.application.nav.welcome_user', name: current_user.display_name) %></span>
                <div class="flex items-center shrink-0 gap-2">
                  <%= button_to t('common.buttons.sign_out'), sign_out_path, method: :delete,
                      form: { data: { turbo: false }, class: "shrink-0 [&_input]:whitespace-nowrap" },
                      class: "shrink-0 px-4 py-2 bg-theme-accent text-white rounded-lg hover:bg-theme-accent-hover transition-colors cursor-pointer font-medium" %>
                  <%= link_to billing_path, class: "shrink-0 whitespace-nowrap px-6 py-2 bg-theme-accent text-white rounded-lg hover:bg-theme-accent-hover transition-colors font-medium shadow-lg" do %>
                    <%= t('layouts.application.nav.my_billing') %>
                  <% end %>
                </div>
                
                <!-- Avatar with dropdown -->
                <div class="relative ml-2" data-controller="avatar-dropdown">
                  <button type="button" 
                          data-action="click->avatar-dropdown#toggle"
                          class="focus:outline-none focus:ring-2 focus:ring-theme-accent rounded-full hover:ring-2 hover:ring-theme-accent transition-all relative z-50">
                    <% if current_user.avatar.attached? %>
                      <%= image_tag current_user.avatar, 
                          class: "w-14 h-14 rounded-full border-2 border-theme-primary shadow-lg object-cover",
                          alt: t('layouts.application.nav.profile_picture') %>
                    <% else %>
                      <!-- Default avatar icon -->
                      <div class="w-14 h-14 rounded-full bg-slate-700 border-2 border-theme-primary shadow-lg flex items-center justify-center">
                        <svg class="w-8 h-8 text-slate-400" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                        </svg>
                      </div>
                    <% end %>
                  </button>
                  
                  <!-- Dropdown menu -->
                  <div data-avatar-dropdown-target="menu" 
                       class="hidden absolute right-0 w-[min(16rem,calc(100vw-1rem))] max-w-[calc(100vw-1rem)] rounded-lg border border-theme-primary bg-theme-card shadow-xl sm:w-64"
                       style="top: 100%; margin-top: 0.5rem;">
                    <div class="py-2">
                      <!-- Language Selector -->
                      <button type="button"
                              data-action="click->avatar-dropdown#toggleLanguage"
                              class="w-full text-left px-4 py-2 text-theme-secondary hover:bg-theme-secondary cursor-pointer transition-colors">
                        <div class="flex items-center justify-between gap-2">
                          <div class="flex items-center gap-2">
                            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                            </svg>
                            <span><%= t("language_names.#{I18n.locale}", locale: :en, default: I18n.locale.to_s.upcase) %></span>
                          </div>
                          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                          </svg>
                        </div>
                      </button>
                      <div data-avatar-dropdown-target="languageMenu" class="hidden">
                        <% I18n.available_locales.each do |loc| %>
                          <a href="<%= url_for(request.query_parameters.merge(locale: loc)) %>"
                             data-turbo="false"
                             class="block pl-11 pr-4 py-2 text-sm <%= I18n.locale == loc ? 'text-theme-accent font-semibold' : 'text-theme-secondary' %> hover:bg-theme-secondary transition-colors">
                            <%= t("language_names.#{loc}", locale: :en, default: loc.to_s.upcase) %>
                          </a>
                        <% end %>
                      </div>

                      <!-- Divider after language -->
                      <div class="border-t border-theme-primary my-2"></div>

                      <!-- Account Settings -->
                      <%= link_to account_settings_path,
                          class: "block px-4 py-2 text-theme-secondary hover:bg-theme-secondary cursor-pointer transition-colors",
                          data: { action: "click->avatar-dropdown#close" } do %>
                        <div class="flex items-center gap-2">
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                          </svg>
                          <span><%= t('layouts.application.dropdown.account_settings') %></span>
                        </div>
                      <% end %>

                      <!-- Profile Settings -->
                      <%= link_to profile_settings_path, 
                          class: "block px-4 py-2 text-theme-secondary hover:bg-theme-secondary cursor-pointer transition-colors",
                          data: { action: "click->avatar-dropdown#close" } do %>
                        <div class="flex items-center gap-2">
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                          </svg>
                          <span><%= t('layouts.application.dropdown.profile_settings') %></span>
                        </div>
                      <% end %>

                      <%= link_to support_center_url,
                          target: "_blank", rel: "noopener noreferrer",
                          class: "block px-4 py-2 text-theme-secondary hover:bg-theme-secondary cursor-pointer transition-colors",
                          data: { action: "click->avatar-dropdown#close" } do %>
                        <div class="flex items-center gap-2">
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"></path>
                          </svg>
                          <span><%= t('sidebar.contact_support') %></span>
                        </div>
                      <% end %>

                      <%= link_to support_center_url,
                          target: "_blank", rel: "noopener noreferrer",
                          class: "block px-4 py-2 text-theme-secondary hover:bg-theme-secondary cursor-pointer transition-colors",
                          data: { action: "click->avatar-dropdown#close" } do %>
                        <div class="flex items-center gap-2">
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
                          </svg>
                          <span><%= t('billing.show.contact_billing_team') %></span>
                        </div>
                      <% end %>
                      
                      <!-- Divider -->
                      <div class="border-t border-theme-primary my-2"></div>
                      
                      <!-- Release Notes -->
                      <%= link_to support_center_url,
                          target: "_blank", rel: "noopener noreferrer",
                          class: "block px-4 py-2 text-theme-secondary hover:bg-theme-secondary cursor-pointer transition-colors",
                          data: { action: "click->avatar-dropdown#close" } do %>
                        <div class="flex items-center gap-2">
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                          </svg>
                          <span><%= t('layouts.application.dropdown.release_notes') %></span>
                        </div>
                      <% end %>
                      <p class="px-4 pb-1 text-xs text-theme-secondary leading-relaxed"><%= t('layouts.application.dropdown.release_notes_instructions') %></p>
                      
                      <!-- Roadmap & Feature Requests -->
                      <%= link_to roadmap_path, 
                          class: "block px-4 py-2 text-theme-secondary hover:bg-theme-secondary cursor-pointer transition-colors",
                          data: { action: "click->avatar-dropdown#close" } do %>
                        <div class="flex items-center gap-2">
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
                          </svg>
                          <span><%= t('layouts.application.dropdown.roadmap') %></span>
                        </div>
                      <% end %>
                      
                      <!-- Version -->
                      <div class="px-4 py-2 text-xs text-theme-secondary border-t border-theme-primary mt-2 pt-2">
                        <div class="flex items-center gap-2">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                          </svg>
                          <span><%= t('layouts.application.dropdown.version', version: Rails.application.config.version || "1.0.0") %></span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              <% elsif mfa_flow_shell && user_signed_in? %>
                <div class="relative" data-controller="language-switcher">
                  <button type="button"
                          data-action="click->language-switcher#toggle"
                          class="<%= guest_lang_btn_class %>">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                    </svg>
                    <%= t("language_names.#{I18n.locale}", locale: :en, default: I18n.locale.to_s.upcase) %>
                  </button>
                  <div data-language-switcher-target="menu"
                       class="<%= guest_lang_menu_class %>">
                    <div class="py-1">
                      <% I18n.available_locales.each do |loc| %>
                        <a href="<%= url_for(request.query_parameters.merge(locale: loc)) %>"
                           data-turbo="false"
                           class="block px-4 py-2 text-sm <%= I18n.locale == loc ? 'text-theme-accent font-semibold' : 'text-theme-secondary' %> hover:bg-theme-secondary transition-colors">
                          <%= t("language_names.#{loc}", locale: :en, default: loc.to_s.upcase) %>
                        </a>
                      <% end %>
                    </div>
                  </div>
                </div>
                <%= button_to t('common.buttons.sign_out'), sign_out_path, method: :delete,
                    form: { data: { turbo: false }, class: "inline-block shrink-0" },
                    class: "px-4 py-2 bg-theme-accent text-white rounded-lg hover:bg-theme-accent-hover transition-colors cursor-pointer font-medium" %>
              <% elsif admin_sessions_shell && user_signed_in? && mfa_verified_for_session? %>
                <div class="relative" data-controller="language-switcher">
                  <button type="button"
                          data-action="click->language-switcher#toggle"
                          class="<%= guest_lang_btn_class %>">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                    </svg>
                    <%= t("language_names.#{I18n.locale}", locale: :en, default: I18n.locale.to_s.upcase) %>
                  </button>
                  <div data-language-switcher-target="menu"
                       class="<%= guest_lang_menu_class %>">
                    <div class="py-1">
                      <% I18n.available_locales.each do |loc| %>
                        <a href="<%= url_for(request.query_parameters.merge(locale: loc)) %>"
                           data-turbo="false"
                           class="block px-4 py-2 text-sm <%= I18n.locale == loc ? 'text-theme-accent font-semibold' : 'text-theme-secondary' %> hover:bg-theme-secondary transition-colors">
                          <%= t("language_names.#{loc}", locale: :en, default: loc.to_s.upcase) %>
                        </a>
                      <% end %>
                    </div>
                  </div>
                </div>
                <%= button_to t('common.buttons.sign_out'), sign_out_path, method: :delete,
                    form: { data: { turbo: false }, class: "inline-block shrink-0" },
                    class: "px-4 py-2 bg-theme-accent text-white rounded-lg hover:bg-theme-accent-hover transition-colors cursor-pointer font-medium" %>
              <% elsif respond_to?(:admin_user?, true) && admin_user? %>
                <!-- Admin signed in (no user session): show Admin Dashboard + Sign out -->
                <%= link_to t('admin.dashboard.title'), admin_root_path, class: "text-[#CAD5E2] hover:text-white transition-colors", data: { turbo_frame: "_top" } %>
                <div class="relative" data-controller="language-switcher">
                  <button type="button"
                          data-action="click->language-switcher#toggle"
                          class="px-3 py-2 text-sm bg-theme-primary border border-theme-primary rounded-lg text-theme-secondary hover:text-theme-primary hover:border-theme-accent transition-colors flex items-center gap-1.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                    </svg>
                    <%= t("language_names.#{I18n.locale}", locale: :en, default: I18n.locale.to_s.upcase) %>
                  </button>
                  <div data-language-switcher-target="menu"
                       class="hidden absolute right-0 mt-2 w-44 bg-theme-card border border-theme-primary rounded-lg shadow-xl z-50">
                    <div class="py-1">
                      <% I18n.available_locales.each do |loc| %>
                        <a href="<%= url_for(request.query_parameters.merge(locale: loc)) %>"
                           data-turbo="false"
                           class="block px-4 py-2 text-sm <%= I18n.locale == loc ? 'text-theme-accent font-semibold' : 'text-theme-secondary' %> hover:bg-theme-secondary transition-colors">
                          <%= t("language_names.#{loc}", locale: :en, default: loc.to_s.upcase) %>
                        </a>
                      <% end %>
                    </div>
                  </div>
                </div>
                <span class="text-[#90A1B9]"><%= t('layouts.application.nav.admin_session_label') %></span>
                <%# button_to: real form + CSRF; avoids GET /admin/logout when Turbo/link DELETE fails (no GET route). %>
                <%= button_to t('common.buttons.sign_out'), admin_logout_path, method: :delete,
                    form: { class: "inline-block shrink-0", data: { turbo: false } },
                    class: "cursor-pointer rounded-lg bg-theme-brand-gradient px-4 py-2 text-center text-base font-medium text-white transition-opacity hover:opacity-95 [&_input]:cursor-pointer [&_input]:border-0 [&_input]:bg-transparent [&_input]:p-0 [&_input]:text-inherit" %>
              <% else %>
                <!-- Language Switcher (anonymous) -->
                <div class="relative w-full md:w-auto" data-controller="language-switcher">
                  <button type="button"
                          data-action="click->language-switcher#toggle"
                          class="w-full justify-center md:w-auto md:justify-start <%= guest_lang_btn_class %>">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                    </svg>
                    <%= t("language_names.#{I18n.locale}", locale: :en, default: I18n.locale.to_s.upcase) %>
                  </button>
                  <div data-language-switcher-target="menu"
                       class="<%= guest_lang_menu_class %> left-0 right-0 w-full min-w-0 md:left-auto md:right-0 md:w-44">
                    <div class="py-1">
                      <% I18n.available_locales.each do |loc| %>
                        <a href="<%= url_for(request.query_parameters.merge(locale: loc)) %>"
                           data-turbo="false"
                           class="block px-4 py-2 text-sm <%= I18n.locale == loc ? 'text-theme-accent font-semibold' : 'text-theme-secondary' %> hover:bg-theme-secondary transition-colors">
                          <%= t("language_names.#{loc}", locale: :en, default: loc.to_s.upcase) %>
                        </a>
                      <% end %>
                    </div>
                  </div>
                </div>

                <%= link_to t("common.buttons.sign_in"), login_path(email_login: 1), data: { turbo: false },
                    class: marketing_guest_shell ? roadmap_guest_sign_in_class : guest_sign_in_class %>
                <%= link_to t("common.buttons.create_account"), create_account_path, data: { turbo: false },
                    class: marketing_guest_shell ? roadmap_guest_sign_in_class : guest_sign_in_class %>
              <% end %>
            </div>
          </div>
          <% if show_guest_beta_banner %>
            <%# Full-width row under logo/auth clusters — avoids squeezing language + CTAs on narrow viewports %>
            <div class="flex w-full justify-center px-2 pt-3 pb-1 md:justify-end md:px-0 md:pt-2 md:pb-0">
              <%= render "shared/guest_beta_discord_banner" %>
            </div>
          <% end %>
          <% end %>
        </nav>
          <% if auth_gate_shell %>
              </div>
            </div>
          <% elsif marketing_landing_width_shell %>
              </div>
            </div>
          <% elsif pricing_public_shell %>
              </div>
            </div>
          <% elsif roadmap_guest_shell %>
              </div>
            </div>
          <% end %>
        
        <%= render "shared/toast_flash_host",
              toast_inset_main_column: member_app_layout_chrome %>

        <%= render "shared/active_compliance_warning_banner" %>
        
          <!-- Main Content -->
          <% if auth_gate_shell %>
            <div class="flex flex-1 flex-col items-center justify-center w-full min-h-0 py-4 pt-8 select-text">
              <%= yield %>
            </div>
          <% elsif marketing_landing_width_shell %>
            <div class="w-full flex-1 min-h-0 select-text">
              <%= yield %>
            </div>
          <% elsif pricing_public_shell %>
            <div class="w-full flex-1 min-h-0 select-text">
              <%= yield %>
            </div>
          <% elsif roadmap_guest_shell %>
            <div class="w-full flex-1 min-h-0 select-text">
              <%= yield %>
            </div>
          <% elsif signed_in_app_shell %>
            <div class="w-full select-text px-6">
              <%= yield %>
            </div>
          <% else %>
            <div class="select-text rounded-xl border border-white/10 bg-[rgba(15,23,43,0.5)] p-8 shadow-lg">
              <%= yield %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    <%= render 'shared/guild_new_add_game_script' %>
  </body>
</html>
