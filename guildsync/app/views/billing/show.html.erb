<div class="space-y-8">
  <div>
    <h1 class="text-4xl font-bold text-theme-primary mb-2"><%= t('billing.show.title') %></h1>
    <p class="text-theme-secondary text-lg"><%= t('billing.show.subtitle') %></p>
  </div>

  <div class="bg-theme-card border border-theme-primary rounded-lg p-6 shadow-lg">
    <h2 class="text-2xl font-semibold mb-4"><%= t('billing.show.current_subscription') %></h2>
    
    <% if @subscription %>
      <div class="space-y-4">
        <div class="flex justify-between items-center">
          <div>
            <div class="text-lg font-medium text-theme-primary">
              <%= @pricing_plan&.name || t('billing.show.no_plan') %>
            </div>
            <div class="text-sm text-theme-secondary mt-1">
              <%= t('billing.show.status_label') %> <span class="<%= @subscription.status == 'active' ? 'text-green-400' : @subscription.status == 'trialing' ? 'text-yellow-400' : 'text-theme-secondary' %>">
                <%= @subscription.status.humanize %>
              </span>
            </div>
          </div>
          <div class="text-right">
            <% if @pricing_plan %>
              <div class="text-2xl font-bold text-theme-accent">
                <%= @pricing_plan.formatted_price %>
              </div>
              <div class="text-sm text-theme-secondary">
                <%= @pricing_plan.formatted_period %>
              </div>
            <% end %>
          </div>
        </div>

        <% if @subscription.in_trial? && @trial_days_remaining %>
          <div class="bg-yellow-900/20 border border-yellow-700 rounded-lg p-4">
            <div class="flex items-center gap-2 mb-2">
              <svg class="w-5 h-5 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span class="text-yellow-400 font-semibold"><%= t('billing.show.trial_period_active') %></span>
            </div>
            <p class="text-yellow-200">
              <% if @trial_days_remaining > 0 %>
                <%= sanitize(t('billing.show.trial_days_remaining_html', days: pluralize(@trial_days_remaining, 'day')), tags: %w[strong]) %>
              <% else %>
                <%= t('billing.show.trial_ended') %>
              <% end %>
            </p>
            <% if @trial_days_remaining && @trial_days_remaining <= 3 && @trial_days_remaining > 0 %>
              <p class="text-sm text-red-300 mt-2">
                <strong>Heads up:</strong> your trial will end soon. Add a payment method now to avoid being moved to Free mode.
              </p>
            <% end %>
            <% if @subscription.trial_ends_at %>
              <p class="text-sm text-yellow-300 mt-2">
                <%= t('billing.show.trial_ends_on') %> <strong><%= @subscription.trial_ends_at.strftime("%B %d, %Y at %I:%M %p") %></strong>
              </p>
            <% end %>
          </div>
        <% end %>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
          <div class="bg-theme-secondary rounded-lg p-4">
            <div class="text-sm text-theme-secondary mb-1"><%= t('billing.show.started') %></div>
            <div class="text-theme-primary font-medium">
              <%= @subscription.started_at.strftime("%B %d, %Y") %>
            </div>
          </div>
          <% if @subscription.expires_at %>
            <div class="bg-theme-secondary rounded-lg p-4">
              <div class="text-sm text-theme-secondary mb-1"><%= t('billing.show.expires') %></div>
              <div class="text-theme-primary font-medium">
                <%= @subscription.expires_at.strftime("%B %d, %Y") %>
              </div>
            </div>
          <% end %>
          <% if @stripe_customer_balance_cents.present? && @stripe_customer_balance_cents < 0 %>
            <% credit_amount = (-@stripe_customer_balance_cents / 100.0) %>
            <div class="bg-green-900/20 border border-green-700 rounded-lg p-4 text-green-200 text-sm">
              <%= t('billing.show.account_credit_html', amount: number_to_currency(credit_amount, unit: "$")) %>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="text-theme-secondary">
        <p><%= t('billing.show.no_active_subscription') %></p>
        <%= link_to t('billing.show.view_plans'), upgrade_pricing_path, class: "mt-4 inline-block px-4 py-2 bg-theme-accent text-white rounded-lg hover:bg-theme-accent-hover transition-colors" %>
      </div>
    <% end %>
  </div>

  <div class="bg-theme-card border border-theme-primary rounded-lg p-6 shadow-lg">
    <h2 class="text-2xl font-semibold mb-4"><%= t('billing.show.payment_management') %></h2>

    <% use_plan_change = @subscription&.stripe_subscription_id.present? %>

    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
      <p class="text-theme-secondary text-sm m-0"><%= t('billing.show.manage_payment_methods') %></p>
      <button type="button" id="manage-billing-btn" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg font-medium transition-colors bg-theme-card text-theme-accent hover:bg-theme-hover border border-theme-primary cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed" data-has-subscription="<%= @subscription&.stripe_customer_id.present? %>" aria-label="<%= t('billing.show.billing_portal') %>">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        <span><%= t('billing.show.billing_portal') %></span>
      </button>
    </div>

    <div class="space-y-4">
      <% if @subscription&.in_trial? || @subscription&.status == 'active' %>
        <div>
          <h3 class="text-lg font-medium text-theme-primary mb-2"><%= t('billing.show.setup_payment_method') %></h3>
          <p class="text-theme-secondary mb-4">
            <% if @subscription&.in_trial? %>
              <%= t('billing.show.setup_payment_trial') %>
            <% else %>
              <%= t('billing.show.setup_payment_current') %>
            <% end %>
          </p>
          
          <% @plans = PricingPlan.active.paid_tiers.order(:display_order) %>
          <% billing_any_annual = @plans.any? { |p| p.effective_stripe_price_id_annual.present? } %>
            <% if use_plan_change %>
              <p class="text-theme-secondary text-sm mb-4"><%= t('billing.show.proration_disclaimer') %></p>
            <% end %>
            <% if @plans.any? %>
            <div data-controller="pricing-plans"
                 data-pricing-plans-checkout-path-value="<%= billing_checkout_path %>"
                 data-pricing-plans-plan-change-path-value="<%= billing_change_plan_path %>"
                 data-pricing-plans-preview-plan-path-value="<%= billing_preview_plan_change_path %>"
                 data-pricing-plans-confirm-plan-change-text-value="<%= t('billing.show.confirm_plan_change') %>"
                 data-pricing-plans-confirm-plan-change-with-amount-text-value="<%= t('billing.show.confirm_plan_change_with_amount') %>"
                 data-pricing-plans-plan-change-failed-text-value="<%= t('js.billing.plan_change_failed') %>"
                 data-pricing-plans-loading-text-value="<%= t('pricing.upgrade.loading') %>"
                 data-pricing-plans-price-missing-text-value="<%= t('js.pricing.price_id_missing') %>"
                 data-pricing-plans-checkout-failed-text-value="<%= t('js.pricing.checkout_failed') %>">
            <% if billing_any_annual %>
              <div class="flex items-center justify-center gap-3 mb-4">
                <span class="text-theme-secondary text-sm font-medium"><%= t('pricing.interval.monthly') %></span>
                <button type="button" class="relative inline-flex h-7 w-14 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent bg-theme-secondary transition-colors focus:outline-none focus:ring-2 focus:ring-theme-accent focus:ring-offset-2" role="switch" aria-checked="false" data-interval="month" data-pricing-plans-target="intervalToggle">
                  <span class="pointer-events-none inline-block h-6 w-6 transform rounded-full bg-theme-accent shadow ring-2 ring-white/70 transition translate-x-1" data-pricing-plans-target="intervalThumb"></span>
                </button>
                <span class="text-theme-secondary text-sm font-medium"><%= t('pricing.interval.annual') %></span>
                <span class="text-xs text-green-400 font-medium"><%= t('pricing.interval.save_annual') %></span>
              </div>
            <% end %>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4 billing-plan-cards" id="billing-plan-cards">
              <% @plans.each_with_index do |plan, idx| %>
                <%
                  in_trial = @subscription&.in_trial?
                  highlight_current = (plan == @subscription&.pricing_plan) && !in_trial
                  bill_has_monthly = plan.effective_stripe_price_id.present?
                  bill_has_annual = plan.effective_stripe_price_id_annual.present?
                %>
                <div class="billing-plan-card bg-theme-secondary border border-theme-primary rounded-lg p-4 <%= 'ring-2 ring-theme-accent' if highlight_current %>" data-plan-index="<%= idx %>" data-pricing-plans-target="planCard">
                  <div class="font-semibold text-theme-primary mb-2"><%= plan.name %></div>
                  <div class="billing-price-wrap mb-2">
                    <span class="billing-price-monthly">
                      <span class="text-2xl font-bold text-theme-accent"><%= plan.formatted_price %></span>
                      <span class="text-theme-secondary text-sm">/<%= plan.period %></span>
                    </span>
                    <% if bill_has_annual && plan.effective_price_display_annual.present? %>
                      <span class="billing-price-annual hidden">
                        <span class="text-2xl font-bold text-theme-accent"><%= plan.formatted_price_annual %></span>
                        <span class="text-theme-secondary text-sm">/year</span>
                      </span>
                    <% end %>
                  </div>
                  <% if (plan.features || []).any? %>
                    <ul class="space-y-1.5 mb-3 mt-1 text-left">
                      <% (plan.features || []).each do |feature| %>
                        <li class="flex items-start">
                          <svg class="w-4 h-4 text-green-500 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                          </svg>
                          <span class="text-theme-secondary text-xs"><%= feature %></span>
                        </li>
                      <% end %>
                    </ul>
                  <% end %>
                  <% if bill_has_monthly %>
                    <% if use_plan_change %>
                      <button type="button" class="billing-plan-change-btn w-full px-4 py-2 rounded-lg font-medium transition-colors cursor-pointer bg-theme-card text-theme-accent hover:bg-theme-hover border border-theme-primary" data-plan-id="<%= plan.id %>" data-price-monthly="<%= plan.effective_stripe_price_id %>" data-price-annual="<%= bill_has_annual ? plan.effective_stripe_price_id_annual : '' %>">
                        <%= t('billing.show.switch_plan') %>
                      </button>
                    <% else %>
                      <button type="button" class="billing-checkout-btn w-full px-4 py-2 rounded-lg font-medium transition-colors cursor-pointer bg-theme-card text-theme-accent hover:bg-theme-hover border border-theme-primary" data-price-monthly="<%= plan.effective_stripe_price_id %>" data-price-annual="<%= bill_has_annual ? plan.effective_stripe_price_id_annual : '' %>">
                        <%= t('pricing.upgrade.subscribe_now') %>
                      </button>
                    <% end %>
                  <% else %>
                    <p class="text-sm text-theme-secondary mb-2"><%= t('controllers.pricing.not_available') %></p>
                    <%= link_to t('pricing.upgrade.subscribe_now'), upgrade_pricing_path, class: "w-full inline-block text-center px-4 py-2 rounded-lg font-medium transition-colors bg-theme-card text-theme-accent hover:bg-theme-hover border border-theme-primary" %>
                  <% end %>
                </div>
              <% end %>
            </div>
            </div>
          <% else %>
            <%= form_with url: billing_portal_path, method: :post, local: true, data: { turbo: false } do |f| %>
              <% if @subscription&.pricing_plan %>
                <%= f.hidden_field :plan_id, value: @subscription.pricing_plan.id %>
              <% end %>
              <%= f.submit t('billing.show.setup_payment'), class: "px-6 py-3 bg-theme-accent text-white rounded-lg hover:bg-theme-accent-hover transition-colors font-medium cursor-pointer" %>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <% if @subscription&.stripe_subscription_id.present? %>
        <div class="border-t border-theme-primary pt-6 mt-6">
          <h3 class="text-lg font-medium text-theme-primary mb-2"><%= t('billing.show.subscription_actions_title') %></h3>
          <% if @stripe_cancel_at_period_end %>
            <p class="text-theme-secondary text-sm mb-4">
              <%= t('billing.show.pending_cancel_html', date: (@stripe_current_period_end&.strftime("%B %d, %Y at %I:%M %p %Z") || t('billing.show.period_end_unknown'))) %>
            </p>
            <%= button_to t('billing.show.resume_subscription'), billing_resume_subscription_path, method: :post, form: { data: { turbo: false } }, class: "px-4 py-2 rounded-lg font-medium bg-theme-accent text-white hover:bg-theme-accent-hover transition-colors cursor-pointer" %>
          <% else %>
            <% if @subscription.refund_eligible? %>
              <p class="text-theme-secondary text-sm mb-4"><%= t('billing.show.refund_window_active') %></p>
            <% else %>
              <p class="text-theme-secondary text-sm mb-4"><%= t('billing.show.cancel_no_refund') %></p>
            <% end %>
            <%= button_to t('billing.show.cancel_subscription'), billing_cancel_subscription_path, method: :post, form: { data: { turbo: false } }, data: { turbo_confirm: t('billing.show.cancel_confirm') }, class: "px-4 py-2 rounded-lg font-medium bg-red-900/40 text-red-200 border border-red-700 hover:bg-red-900/60 transition-colors cursor-pointer" %>
          <% end %>
        </div>
      <% end %>

      <!-- 4th box: Free plan & free user mode -->
      <div class="border-t border-theme-primary pt-6 mt-6">
        <h3 class="text-xl font-bold text-theme-primary mb-2"><%= t('pricing.upgrade.free_user_mode_box.title') %></h3>
        <p class="text-theme-secondary text-sm mb-4"><%= t('pricing.upgrade.free_user_mode_box.description') %></p>
        <ul class="space-y-2 mb-0">
          <% t('pricing.upgrade.free_user_mode_box.features').each do |feature| %>
            <li class="flex items-start text-theme-secondary text-sm">
              <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <%= feature %>
            </li>
          <% end %>
        </ul>
      </div>

      <div class="border-t border-theme-primary pt-4">
        <h3 class="text-lg font-medium text-theme-primary mb-2"><%= t('billing.show.need_help') %></h3>
        <p class="text-theme-secondary mb-4">
          <%= t('billing.show.need_help_description') %>
        </p>
        <%= link_to t('billing.show.contact_billing_team'), support_center_url, target: "_blank", rel: "noopener noreferrer", class: "inline-block px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium" %>
        <p class="text-xs text-theme-secondary mt-3 max-w-lg"><%= t('support.disclaimer') %></p>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    if (window.__guildsyncBillingPortalDelegate) return;
    window.__guildsyncBillingPortalDelegate = true;
    document.addEventListener('click', function (e) {
      var manageBillingBtn = e.target.closest('#manage-billing-btn');
      if (!manageBillingBtn || manageBillingBtn.disabled) return;
      e.preventDefault();
      manageBillingBtn.disabled = true;
      var btnText = manageBillingBtn.querySelector('span');
      if (btnText) btnText.textContent = '<%= j t('billing.show.js_loading') %>';
      fetch('<%= billing_portal_path(format: :json) %>', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || ''
        }
      })
        .then(function(r) { if (!r.ok) return r.json().then(function(d) { throw new Error(d.error || 'Failed'); }); return r.json(); })
        .then(function(data) { if (data.url) window.location.href = data.url; else throw new Error('No URL'); })
        .catch(function(err) {
          console.error(err);
          window.showToast('error', '<%= j t('js.billing.portal_failed') %>');
          manageBillingBtn.disabled = false;
          if (btnText) {
            var hasSub = manageBillingBtn.getAttribute('data-has-subscription') === 'true';
            btnText.textContent = hasSub ? '<%= j t('billing.show.js_manage_billing') %>' : '<%= j t('billing.show.billing_portal') %>';
          }
        });
    });
  })();
</script>

