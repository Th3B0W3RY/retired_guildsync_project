<%# locals: (user:) %>
<tr id="admin_beta_feature_row_<%= user.id %>" class="hover:bg-theme-secondary/40">
  <td class="px-4 py-3 text-theme-secondary"><%= user.id %></td>
  <td class="px-4 py-3 text-theme-primary"><%= user.username %></td>
  <td class="px-4 py-3 text-theme-secondary"><%= user.email %></td>
  <td class="px-4 py-3"><%= user.beta_features_enabled? ? t("admin.beta_features.enabled_yes") : t("admin.beta_features.enabled_no") %></td>
  <td class="px-4 py-3 flex flex-wrap gap-2">
    <% if user.beta_features_enabled? %>
      <%= button_to t("admin.beta_features.disable"), admin_beta_feature_disable_path(user_id: user.id), method: :post, class: "px-3 py-1 bg-amber-900/40 border border-amber-500/40 rounded text-amber-200 text-xs hover:bg-amber-900/60", form: { data: { turbo_frame: "_top" } } %>
    <% else %>
      <%= button_to t("admin.beta_features.enable"), admin_beta_feature_enable_path(user_id: user.id), method: :post, class: "px-3 py-1 bg-green-900/40 border border-green-500/40 rounded text-green-300 text-xs hover:bg-green-900/60", form: { data: { turbo_frame: "_top" } } %>
    <% end %>
    <%= link_to t("admin.beta_features.view_user"), admin_user_path(user), class: "text-theme-accent text-xs", data: { turbo_frame: "_top" } %>
  </td>
</tr>
