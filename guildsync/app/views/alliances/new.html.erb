<div class="mx-auto max-w-2xl p-6 font-[family-name:Inter,ui-sans-serif,system-ui,sans-serif]">
  <div class="mb-6">
    <h1 class="mb-2 text-3xl font-bold text-white"><%= t('alliances.new.title') %></h1>
    <p class="text-[#90A1B9]"><%= t('alliances.new.subtitle') %></p>
  </div>

  <%= form_with model: @alliance, url: alliances_path, local: true, multipart: true, class: "space-y-6 rounded-xl border border-white/10 bg-[rgba(15,23,43,0.5)] p-6 shadow-lg", data: { turbo: false } do |f| %>
    <% if @alliance.errors.any? %>
      <div class="bg-red-900/20 border border-red-500 rounded-lg p-4">
        <ul class="list-disc list-inside text-red-400">
          <% @alliance.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, t('alliances.form.name'), class: "mb-2 block text-sm font-medium text-white" %>
      <%= f.text_field :name, class: "w-full rounded-lg border border-white/10 bg-[rgba(2,6,24,0.5)] px-4 py-2 text-white placeholder:text-[#90A1B9]",
          placeholder: t('alliances.form.name_placeholder'), required: true %>
    </div>

    <div>
      <%= f.label :description, t('alliances.form.description'), class: "mb-2 block text-sm font-medium text-white" %>
      <%= f.text_area :description, rows: 4, class: "w-full rounded-lg border border-white/10 bg-[rgba(2,6,24,0.5)] px-4 py-2 text-white placeholder:text-[#90A1B9]",
          placeholder: t('alliances.form.description_placeholder') %>
    </div>

    <div>
      <%= f.label :logo, t('alliances.form.logo'), class: "mb-2 block text-sm font-medium text-white" %>
      <%= render "alliances/logo_file_field", f: f %>
    </div>

    <div class="bg-blue-900/20 border border-blue-500/30 rounded-lg p-4">
      <p class="text-sm text-blue-300">
        <strong><%= t('alliances.form.creating_for') %></strong> <%= @guild.name %>
      </p>
      <p class="text-xs text-blue-400 mt-1"><%= t('alliances.form.size_info') %></p>
    </div>

    <div class="flex gap-4">
      <%= f.submit t('alliances.form.create_button'), class: "cursor-pointer rounded-lg bg-theme-brand-gradient px-6 py-3 font-semibold text-white transition-opacity hover:opacity-95" %>
      <%= link_to t('common.buttons.cancel'), dashboard_path, class: "rounded-lg border border-white/10 bg-[rgba(15,23,43,0.35)] px-6 py-3 font-semibold text-[#CAD5E2] transition-colors hover:bg-[rgba(15,23,43,0.55)]" %>
    </div>
  <% end %>
</div>
