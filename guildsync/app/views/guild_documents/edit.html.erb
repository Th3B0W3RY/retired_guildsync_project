<style>
  /* Tiptap Editor Dark Theme Styling */
  [data-editor-target="editor"] .ProseMirror {
    outline: none;
    color: #e5e7eb;
  }
  
  [data-editor-target="editor"] .ProseMirror p {
    margin: 0.5em 0;
    color: #e5e7eb;
  }
  
  [data-editor-target="editor"] .ProseMirror p.is-editor-empty:first-child::before {
    color: #9ca3af;
    content: attr(data-placeholder);
    float: left;
    height: 0;
    pointer-events: none;
  }
  
  [data-editor-target="editor"] .ProseMirror h1,
  [data-editor-target="editor"] .ProseMirror h2,
  [data-editor-target="editor"] .ProseMirror h3,
  [data-editor-target="editor"] .ProseMirror h4 {
    color: #f3f4f6;
    font-weight: 600;
    margin-top: 1em;
    margin-bottom: 0.5em;
  }
  
  [data-editor-target="editor"] .ProseMirror h1 {
    font-size: 2em;
  }
  
  [data-editor-target="editor"] .ProseMirror h2 {
    font-size: 1.5em;
  }
  
  [data-editor-target="editor"] .ProseMirror ul,
  [data-editor-target="editor"] .ProseMirror ol {
    padding-left: 1.5em;
    color: #e5e7eb;
  }
  
  [data-editor-target="editor"] .ProseMirror li {
    color: #e5e7eb;
  }
  
  [data-editor-target="editor"] .ProseMirror a {
    color: #818cf8;
    text-decoration: underline;
  }
  
  [data-editor-target="editor"] .ProseMirror a:hover {
    color: #a5b4fc;
  }
  
  [data-editor-target="editor"] .ProseMirror strong {
    color: #f3f4f6;
    font-weight: 600;
  }
  
  [data-editor-target="editor"] .ProseMirror em {
    color: #e5e7eb;
    font-style: italic;
  }
  
  [data-editor-target="editor"] .ProseMirror code {
    background-color: rgba(0, 0, 0, 0.3);
    color: #fbbf24;
    padding: 0.2em 0.4em;
    border-radius: 0.25rem;
    font-size: 0.9em;
  }
  
  [data-editor-target="editor"] .ProseMirror pre {
    background-color: rgba(0, 0, 0, 0.4);
    color: #e5e7eb;
    padding: 1em;
    border-radius: 0.5rem;
    overflow-x: auto;
  }
  
  [data-editor-target="editor"] .ProseMirror blockquote {
    border-left: 4px solid #4b5563;
    padding-left: 1em;
    color: #d1d5db;
    font-style: italic;
  }
  [data-editor-target="editor"] .ProseMirror img {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }
</style>

<div class="max-w-5xl mx-auto p-6">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-theme-primary mb-2"><%= t('guild_documents.edit.title') %></h1>
    <p class="text-theme-secondary"><%= t('guild_documents.edit.subtitle', guild_name: @guild.name) %></p>
  </div>

  <%= form_with model: @document, url: guild_document_path(@guild, @document), local: true, data: { turbo: false }, class: "space-y-6" do |f| %>
    <% if @document.errors.any? %>
      <div class="bg-red-600 border border-red-800 rounded-lg p-4">
        <h3 class="text-white font-semibold mb-2"><%= t('guild_documents.edit.fix_errors') %></h3>
        <ul class="list-disc list-inside text-white">
          <% @document.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-theme-card border border-theme-primary rounded-lg p-6">
      <div class="mb-4">
        <%= f.label :title, class: "block text-sm font-medium text-theme-primary mb-2" %>
        <%= f.text_field :title, class: "w-full px-4 py-2 bg-theme-secondary border border-theme-primary rounded-lg text-theme-primary focus:outline-none focus:ring-2 focus:ring-theme-accent", placeholder: t('guild_documents.edit.document_title_placeholder') %>
      </div>

            <div class="mb-4">
              <%= f.label :visibility, class: "block text-sm font-medium text-theme-primary mb-2" %>
              <%= f.select :visibility, options_for_select([
                [t('guild_documents.edit.visibility_private'), "private_doc"],
                [t('guild_documents.edit.visibility_public'), "public_doc"],
                [t('guild_documents.edit.visibility_unlisted'), "unlisted_doc"]
              ], @document.visibility), {}, { class: "gs-native-select gs-native-select--field w-full px-4 bg-theme-secondary border border-theme-primary rounded-lg text-theme-primary focus:outline-none focus:ring-2 focus:ring-theme-accent" } %>
            </div>

            <div class="mb-4">
              <%= f.label :folder_id, t('guild_documents.edit.folder_optional'), class: "block text-sm font-medium text-theme-primary mb-2" %>
              <%= f.select :folder_id, options_for_select([
                [t('guild_documents.edit.no_folder'), ""]
              ] + (@folders || @guild.guild_document_folders.ordered).map { |folder| [folder.name, folder.id] }, @document.folder_id), {}, { class: "gs-native-select gs-native-select--field w-full px-4 bg-theme-secondary border border-theme-primary rounded-lg text-theme-primary focus:outline-none focus:ring-2 focus:ring-theme-accent" } %>
            </div>

      <div
        data-controller="editor"
        data-editor-upload-url-value="<%= upload_image_guild_documents_path(@guild) %>"
        class="mb-4"
      >
        <%= f.label :content, t('guild_documents.edit.content'), class: "block text-sm font-medium text-theme-primary mb-2" %>
        <div class="bg-theme-secondary border border-theme-primary rounded-lg p-2 mb-2">
          <div class="flex flex-wrap gap-2">
            <button type="button" data-action="editor#bold" class="px-3 py-1 bg-theme-card hover:bg-theme-hover border border-theme-primary rounded text-theme-primary text-sm font-bold">B</button>
            <button type="button" data-action="editor#italic" class="px-3 py-1 bg-theme-card hover:bg-theme-hover border border-theme-primary rounded text-theme-primary text-sm italic">I</button>
            <button type="button" data-action="editor#underline" class="px-3 py-1 bg-theme-card hover:bg-theme-hover border border-theme-primary rounded text-theme-primary text-sm underline">U</button>
            <button type="button" data-action="editor#heading1" class="px-3 py-1 bg-theme-card hover:bg-theme-hover border border-theme-primary rounded text-theme-primary text-sm">H1</button>
            <button type="button" data-action="editor#heading2" class="px-3 py-1 bg-theme-card hover:bg-theme-hover border border-theme-primary rounded text-theme-primary text-sm">H2</button>
            <button type="button" data-action="editor#bulletList" class="px-3 py-1 bg-theme-card hover:bg-theme-hover border border-theme-primary rounded text-theme-primary text-sm">• List</button>
            <button type="button" data-action="editor#orderedList" class="px-3 py-1 bg-theme-card hover:bg-theme-hover border border-theme-primary rounded text-theme-primary text-sm">1. List</button>
            <button type="button" data-action="editor#addLink" class="px-3 py-1 bg-theme-card hover:bg-theme-hover border border-theme-primary rounded text-theme-primary text-sm">🔗 Link</button>
            <button type="button" data-action="editor#uploadImage" class="px-3 py-1 bg-theme-card hover:bg-theme-hover border border-theme-primary rounded text-theme-primary text-sm" title="<%= t('guild_documents.toolbar.image') %>">🖼️ Image</button>
            <button type="button" data-action="editor#addVideo" class="px-3 py-1 bg-theme-card hover:bg-theme-hover border border-theme-primary rounded text-theme-primary text-sm">▶️ Video</button>
          </div>
        </div>
        <div
          data-editor-target="editor"
          class="min-h-[400px] bg-theme-secondary border border-theme-primary rounded-lg p-4 text-theme-primary focus-within:ring-2 focus-within:ring-theme-accent prose prose-invert max-w-none"
          style="cursor: text; outline: none; overflow-y: auto;"
        ></div>
        <%= f.hidden_field :content, data: { editor_target: "input" }, value: (@document.content.present? ? @document.content.to_json : { type: "doc", content: [] }.to_json) %>
      </div>
    </div>

    <div class="flex items-center justify-end gap-4">
      <%= link_to t('guild_documents.edit.cancel'), guild_document_path(@guild, @document), class: "px-6 py-2 bg-theme-secondary text-theme-primary rounded-lg hover:bg-theme-hover transition-colors" %>
      <%= f.submit t('guild_documents.edit.update_document'), class: "px-6 py-2 bg-theme-accent text-white rounded-lg hover:bg-theme-accent-hover transition-colors cursor-pointer" %>
    </div>
  <% end %>
</div>

