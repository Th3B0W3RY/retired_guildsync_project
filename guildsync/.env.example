# =============================================================================
# GuildSync — environment template (copy to .env and fill in values)
# =============================================================================
# This file is for the Rails app/server process under guildsync/.
# Playwright runner-only overrides live in ../external_tests/.env.example.
#
# Local development: keep RAILS_ENV=development below. Use guildsync_development
#   (DATABASE_NAME) for bin/dev and the browser — not the test DB.
#
# Automated specs: `bundle exec rspec` loads spec/rails_helper.rb, which sets
#   RAILS_ENV=test for that process only. Do NOT set RAILS_ENV=test in .env, or
#   your dev server and console would run against the test environment.
#
# Test DB: TEST_DATABASE_NAME (default guildsync_test). After migrations, either
#   run `bin/rails db:test:prepare` or rely on maintain_test_schema! when you
#   run RSpec. `bin/setup` runs db:test:prepare for you.
#
# Production VM: RAILS_ENV=production, DATABASE_NAME=guildsync, set HOST / FRONTEND_URL
# =============================================================================

# -----------------------------------------------------------------------------
# Rails
# -----------------------------------------------------------------------------
RAILS_ENV=development
SECRET_KEY_BASE=
# openssl rand -hex 64

RAILS_MAX_THREADS=5
RAILS_LOG_LEVEL=info

# Puma HTTP port (development default 5000 in config/puma.rb if unset)
PORT=5000

# -----------------------------------------------------------------------------
# Account self-service deletion
# -----------------------------------------------------------------------------
# Production: ON by default (UI + POST endpoints). Set to 0 to disable (kill switch).
# Staging / development / test: always enabled; this variable is ignored.
# ACCOUNT_SELF_DELETE_ENABLED=0

# Optional overrides for per-hour limits (defaults: 5 send, 20 confirm — see Rack::Attack + AccountDeletion::RateLimits)
# ACCOUNT_DELETION_SEND_LIMIT_PER_HOUR=5
# ACCOUNT_DELETION_CONFIRM_LIMIT_PER_HOUR=20
#
# Profile Settings: POST /profile/settings/email_verification (default 10/hour per IP in production)
# PROFILE_EMAIL_VERIFICATION_SEND_LIMIT_PER_HOUR=10

# -----------------------------------------------------------------------------
# Database — local Postgres (typical: `postgres` superuser + password you set on the host)
# -----------------------------------------------------------------------------
# Development default in database.yml is guildsync_development if DATABASE_NAME is unset.
DATABASE_NAME=guildsync_development
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
# Production PostgreSQL TLS mode (default: require). Options: disable, allow, prefer, require, verify-ca, verify-full
# Omit or set to "prefer" for local development; production database.yml defaults to "require".
# DATABASE_SSLMODE=require

# Explicit test DB name (same DATABASE_USER / DATABASE_PASSWORD / host as above unless you override)
TEST_DATABASE_NAME=guildsync_test
# TEST_DATABASE_USER=postgres
# TEST_DATABASE_PASSWORD=
# TEST_DATABASE_HOST=127.0.0.1
# TEST_DATABASE_PORT=5432

# One-off tasks against the test DB (rare): RAILS_ENV=test bin/rails db:migrate
#   Prefer: bin/rails db:test:prepare (no need to change RAILS_ENV in .env).

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Production TLS: use rediss:// scheme (note the double-s) to encrypt Redis traffic.
# Most hosted Redis providers (Render, Heroku, Fly.io) require this.
# Example: REDIS_URL=rediss://:password@your-redis-host:6380/0
#
# If your provider uses a self-signed certificate, also set:
# REDIS_SSL_VERIFY_NONE=1

# Alternative (if not using REDIS_URL)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_CACHE_DB=0
# REDIS_SIDEKIQ_DB=1

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
HOST=localhost
FRONTEND_URL=http://localhost:5000
# Canonical absolute app URL used by Stripe return URLs, admin/error links, and
# integration-test URL helpers. In production, set this to https://guild-sync.net.
APP_URL=http://localhost:5000

# Production VM — set these (same file as SMTP below; do not leave HOST=localhost on the server):
#   HOST=guild-sync.net
#   APP_URL=https://guild-sync.net
#   MAILER_URL_PROTOCOL=https
#
# Mailer URL protocol defaults to https in production.rb when unset; use MAILER_URL_PROTOCOL=http
# only in exceptional setups.

# Optional: guest top bar “Join Discord” link
# COMMUNITY_DISCORD_INVITE_URL=https://discord.gg/your-invite

# ------------------------------------------------------------------------------
# Email / SMTP / Resend (transactional mail — production)
# ------------------------------------------------------------------------------
# GuildSync sends outbound email in production via Action Mailer SMTP.
# We use Resend as the transactional provider; variable names stay generic SMTP so you
# could point at another host later. See: https://resend.com/docs/send-with-smtp
#
# Do NOT commit real API keys or secrets. Values below are fake examples for local docs only.
# After adding these on your server via /var/www/guildsync/guildsync/.env, restart BOTH Puma and Sidekiq
# (deploy/guildsync.service + deploy/guildsync-sidekiq.service load the same EnvironmentFile). If Sidekiq
# starts without SMTP_PASSWORD / SMTP_ADDRESS, ActionMailer::MailDeliveryJob can fail with
# ECONNREFUSED to localhost:25.
# deploy/deploy.sh runs `rake guildsync:verify_production_mailer_config` after starting Puma + Sidekiq
# so a bad mail config fails the deploy, not silently at runtime.
#
# Resend: create an API key, verify your sending domain in the Resend dashboard, then add DNS
# records (your registrar / Spaceship may show hostnames only, e.g.):
#   - resend._domainkey  (DKIM TXT from Resend)
#   - send               (SPF / routing per Resend instructions)
#   - _dmarc             (DMARC policy TXT — recommended)
#
# Production mail — variable names you should have on the server (see explicit values below):
#   HOST, MAILER_URL_PROTOCOL, SMTP_PASSWORD, MAILER_FROM, SMTP_ADDRESS, SMTP_PORT, SMTP_USERNAME,
#   SMTP_DOMAIN, SMTP_AUTHENTICATION, SMTP_ENABLE_STARTTLS_AUTO, SMTP_OPEN_TIMEOUT, SMTP_READ_TIMEOUT,
#   SMTP_RAISE_DELIVERY_ERRORS  (optional escape hatch: SMTP_ALLOW_LOCAL_MAILER=1)
#
# --- Smallest production set (works with code defaults; not recommended long-term) ---
# You can start with only your Resend API key and a verified From address:
#
#   SMTP_PASSWORD=<your_resend_api_key>
#   MAILER_FROM=no-reply@guild-sync.net
#
# The app defaults SMTP_ADDRESS=smtp.resend.com, SMTP_PORT=587, SMTP_USERNAME=resend, etc.
# Still override HOST (+ MAILER_URL_PROTOCOL if needed) under “Application URLs” above so links in
# email (verify profile, password reset) use your real public hostname, not localhost.
#
# --- Recommended production block (explicit; copy for server .env + restart Puma + Sidekiq) ---
#
# Recommended production server: set the following in this file (or merge with your existing
# .env). Use “Application URLs” above for HOST — production must override HOST=localhost, e.g.:
#   HOST=guild-sync.net
#   MAILER_URL_PROTOCOL=https
#
SMTP_ADDRESS=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_fake_resend_api_key_replace_me
SMTP_DOMAIN=guild-sync.net
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPEN_TIMEOUT=5
SMTP_READ_TIMEOUT=5
SMTP_RAISE_DELIVERY_ERRORS=true
# Refuse implicit local MTA (localhost:25) on boot unless you intentionally run postfix/ssmtp there.
# Omit in normal production (Resend uses smtp.resend.com:587).
# SMTP_ALLOW_LOCAL_MAILER=1
MAILER_FROM=no-reply@guild-sync.net
# Optional: billing/trial mail separate From (must also be verified in Resend if set).
# BILLING_MAILER_FROM=billing@guild-sync.net

# -----------------------------------------------------------------------------
# Authentication & security
# -----------------------------------------------------------------------------
JWT_SECRET=
# openssl rand -hex 64

# Cloudflare Turnstile (signup). Both required for enforcement on web + API signup.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_STRICT_IN_TEST=1

# -----------------------------------------------------------------------------
# Google OAuth sign-in
# -----------------------------------------------------------------------------
# Production server: set these in /var/www/guildsync/guildsync/.env, then restart:
#   sudo systemctl restart guildsync guildsync-sidekiq
# These are GuildSync's OAuth app credentials, not user credentials.
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx

# -----------------------------------------------------------------------------
# Microsoft 365 OAuth sign-in
# -----------------------------------------------------------------------------
# Production server: set these in /var/www/guildsync/guildsync/.env, then restart:
#   sudo systemctl restart guildsync guildsync-sidekiq
# These are GuildSync's OAuth app credentials, not user credentials.
# Microsoft Entra / Azure App Registration:
#   MICROSOFT_CLIENT_ID     = Overview page -> Application (client) ID.
#   MICROSOFT_CLIENT_SECRET = Certificates & secrets -> Client secrets table -> Value column.
#                             In the Azure table, use the LEFT "Value" column, not the RIGHT "Secret ID" column.
# Production redirect URI:
#   https://guild-sync.net/auth/microsoft/callback
MICROSOFT_CLIENT_ID=xxxxx-xxxxx-xxxxx
MICROSOFT_CLIENT_SECRET=xxxxx

# Active Record encryption (production: required). Generate: bin/rails db:encryption:init
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
# Development without these: keys are derived from SECRET_KEY_BASE (see config/initializers/active_record_encryption.rb)

# -----------------------------------------------------------------------------
# Discord
# -----------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
# Secret used by /discord/event_signups/webhook requests from trusted automation.
DISCORD_EVENT_SIGNUPS_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

STRIPE_BASIC_PRICE_ID=price_
STRIPE_UPGRADED_PRICE_ID=price_
STRIPE_ELITE_PRICE_ID=price_

STRIPE_BASIC_PRICE_ID_ANNUAL=price_
STRIPE_UPGRADED_PRICE_ID_ANNUAL=price_
STRIPE_ELITE_PRICE_ID_ANNUAL=price_

# -----------------------------------------------------------------------------
# Admin panel
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ADMIN_EMAILS=admin1@example.com,admin2@example.com

# -----------------------------------------------------------------------------
# Typesense (optional)
# -----------------------------------------------------------------------------
TYPESENSE_ENABLED=false
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=

# -----------------------------------------------------------------------------
# Azure AI Vision (OCR)
# -----------------------------------------------------------------------------
GUILDSYNC_AZURE_VISION_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
GUILDSYNC_AZURE_VISION_KEY=

# -----------------------------------------------------------------------------
# IGDB / Twitch API
# -----------------------------------------------------------------------------
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Background jobs & Python (OCR / embeddings)
# -----------------------------------------------------------------------------
SIDEKIQ_CONCURRENCY=10
SIDEKIQ_CLIENT_POOL_SIZE=5
GUILDSYNC_PYTHON_CMD=/path/to/your/venv/bin/python
# Local without venv: python3

# Node (Azure OCR bridge script, if used)
# GUILDSYNC_NODE_CMD=node

# -----------------------------------------------------------------------------
# S3-compatible storage
# -----------------------------------------------------------------------------
# AWS: set bucket, keys, region; omit S3_ENDPOINT.
# Hetzner / DigitalOcean Spaces: set S3_ENDPOINT and region.
S3_BUCKET=guildsync-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=eu-central-1
# S3_ENDPOINT=https://nbg1.your-objectstorage.com

# S3_SSE_AES256=1
# S3_ACL=private

# -----------------------------------------------------------------------------
# Logging & uploads
# -----------------------------------------------------------------------------
# Production VM example: /var/www/guildsync/guildsync/log
GUILDSYNC_LOG_DIR=

# Max gear screenshot upload size in MB (default 0.8). Match nginx client_max_body_size.
GEAR_UPLOAD_MAX_MB=4

# -----------------------------------------------------------------------------
# Optional: skip OCR preprocessing (development)
# -----------------------------------------------------------------------------
# SKIP_OCR_PREPROCESSING=true

# -----------------------------------------------------------------------------
# Playwright integration tests (local dev only — never set in production)
# Allows multiple user sign-ups from 127.0.0.1/::1 by bypassing the
# one_account_per_ip validation. Set this when running `bin/rails server` for
# Playwright tests against the development server.
#
# Runner-side values such as BASE_URL, API_BASE_URL, TEST_MFA_SECRET,
# PLAYWRIGHT_FULL_SUITE, and DEBUG_SKIP_REASONS belong in
# ../external_tests/.env, not this Rails app env file.
# -----------------------------------------------------------------------------
# INTEGRATION_TESTS=1
