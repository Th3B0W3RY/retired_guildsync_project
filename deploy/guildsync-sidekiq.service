[Unit]
Description=GuildSync Sidekiq
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/guildsync/guildsync
Environment=RAILS_ENV=production
Environment=RACK_ENV=production
EnvironmentFile=-/var/www/guildsync/guildsync/.env
ExecStart=/home/deploy/.rbenv/bin/rbenv exec bundle exec sidekiq -C config/sidekiq.yml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
