<div class="max-w-7xl mx-auto p-6">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-theme-primary mb-2"><%= t("storage.show.title") %></h1>
    <p class="text-theme-secondary"><%= t("storage.show.subtitle", guild_name: @guild.name) %></p>
  </div>

  <div class="flex flex-col gap-6 lg:flex-row">
    <aside class="lg:w-72 shrink-0 rounded-xl border border-theme-primary bg-theme-secondary/40 p-4">
      <h2 class="text-lg font-semibold text-theme-primary mb-3"><%= t("storage.show.folders") %></h2>
      <div class="storage-folder-tree">
        <%= render "storage/folder_tree_branch", tree: @folder_tree %>
      </div>
    </aside>

    <div class="min-w-0 flex-1 space-y-6">
      <% if @current_folder %>
        <nav class="text-sm text-theme-secondary" aria-label="Breadcrumb">
          <%= link_to t("storage.show.root"), guild_storage_path(@guild), class: "hover:text-theme-accent" %>
          <% @current_folder.ancestors.reverse.each do |ancestor| %>
            <span class="mx-1 text-theme-secondary">/</span>
            <%= link_to ancestor.name, guild_storage_path(@guild, folder_id: ancestor.id), class: "hover:text-theme-accent" %>
          <% end %>
          <span class="mx-1 text-theme-secondary">/</span>
          <span class="text-theme-primary font-medium"><%= @current_folder.name %></span>
        </nav>
      <% end %>

      <div
        id="bulk-actions-bar"
        class="flex flex-wrap items-center gap-3 rounded-lg border border-theme-primary bg-theme-card px-4 py-3 text-sm"
        data-testid="bulk-actions-bar"
      >
        <span class="font-medium text-theme-primary"><%= t("storage.show.move") %></span>
        <span class="font-medium text-theme-primary"><%= t("storage.show.delete") %></span>
      </div>

      <div class="rounded-xl border border-dashed border-theme-primary bg-theme-secondary/30 p-6 text-center text-theme-secondary">
        <p class="text-theme-primary font-medium"><%= t("storage.show.drag_drop") %></p>
        <p class="mt-2 text-sm"><%= t("storage.show.paste_clipboard") %></p>
        <p class="mt-4">
          <%= link_to t("storage.show.browse_files"), "#", class: "text-theme-accent hover:underline" %>
        </p>
      </div>

      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <% @file_entries.each do |entry| %>
          <div class="rounded-lg border border-theme-primary bg-theme-card p-4">
            <p class="font-medium text-theme-primary truncate" title="<%= entry.name %>"><%= entry.name %></p>
          </div>
        <% end %>
      </div>

      <% if @file_entries.empty? %>
        <p class="text-sm text-theme-secondary"><%= t("storage.show.no_files_uploaded") %></p>
      <% end %>
    </div>
  </div>
</div>
