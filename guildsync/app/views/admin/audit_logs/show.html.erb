<div class="space-y-6">
  <div class="flex justify-between items-center">
    <h1 class="text-3xl font-bold text-theme-accent"><%= t("admin.audit_logs.show.page_title") %></h1>
    <%= link_to t("admin.audit_logs.show.back_to_index"), admin_audit_logs_path,
          class: "px-4 py-2 bg-theme-secondary text-theme-primary rounded-lg hover:bg-theme-hover transition-colors",
          data: { turbo_frame: "_top" } %>
  </div>

  <%= turbo_frame_tag Admin::AuditLogsController::AUDIT_LOGS_SHOW_MAIN_FRAME do %>
    <%= render "audit_logs_show_main" %>
  <% end %>
</div>
