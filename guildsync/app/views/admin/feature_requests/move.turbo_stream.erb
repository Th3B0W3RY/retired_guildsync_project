<% if @move_noop %>
  <%= turbo_stream.update "admin_feature_requests_flash" do %>
    <p class="rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-2 text-sm text-emerald-400"><%= @move_notice %></p>
  <% end %>
<% else %>
  <% if @target_was_empty %>
    <%= turbo_stream.remove "admin_roadmap_empty_#{@new_status}" %>
  <% end %>
  <%= turbo_stream.remove "admin_feature_request_card_#{@feature_request.id}" %>
  <%= turbo_stream.append "admin_roadmap_column_list_#{@new_status}" do %>
    <%= render "admin/feature_requests/feature_request_card", fr: @feature_request %>
  <% end %>
  <% if FeatureRequest.where(status: @old_status).count.zero? %>
    <%= turbo_stream.append "admin_roadmap_column_list_#{@old_status}" do %>
      <p id="admin_roadmap_empty_<%= @old_status %>" class="text-theme-secondary text-sm italic"><%= t("roadmap.empty_column") %></p>
    <% end %>
  <% end %>
  <%= turbo_stream.update "admin_feature_requests_flash" do %>
    <p class="rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-2 text-sm text-emerald-400"><%= @move_notice %></p>
  <% end %>
<% end %>
