<%# Figma global shell (node 64-*): same strip treatment as marketing roadmap bar; main column only (sidebar offset in layout). %>
<div class="mb-6 flex h-16 w-full shrink-0 items-center justify-between gap-4 border-b border-white/5 bg-[rgba(2,6,24,0.88)] px-6">
  <div class="flex min-w-0 items-center gap-3 lg:gap-6">
    <%# Narrow desktop (< lg): reuse mobile-shell drawer (layout root). %>
    <button type="button"
            class="shrink-0 rounded-lg border border-white/10 p-2 text-slate-200 hover:bg-white/5 lg:hidden"
            data-action="click->mobile-shell#toggle"
            aria-controls="desktop-sidebar-panel"
            aria-label="<%= t('sidebar.navigation') %>">
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
    <%= link_to root_path, class: "flex shrink-0 items-center gap-2" do %>
      <span class="flex h-8 w-8 items-center justify-center rounded-[10px] bg-gradient-to-br from-[#615FFF] to-[#9810FA] text-sm font-bold leading-5 text-white">GS</span>
      <span class="bg-gradient-to-r from-[#7C86FF] to-[#C27AFF] bg-clip-text text-lg font-semibold leading-7 text-transparent"><%= t("app_name") %></span>
    <% end %>
    <div class="hidden items-center gap-5 md:flex">
      <%= link_to t("layouts.application.nav.pricing"), pricing_path, class: "inline-flex shrink-0 items-center text-base font-normal leading-6 whitespace-nowrap text-[#CAD5E2] transition-colors hover:text-white" %>
      <%= link_to t("layouts.application.nav.roadmap"), roadmap_path, class: "inline-flex shrink-0 items-center text-base font-normal leading-6 whitespace-nowrap text-[#CAD5E2] transition-colors hover:text-white" %>
    </div>
    <%= link_to t("layouts.application.nav.upgrade_plan"), upgrade_pricing_path, class: "hidden text-sm text-[#7C86FF] transition-colors hover:text-white lg:inline" %>
  </div>

  <div class="flex min-w-0 flex-1 items-center justify-end gap-2 sm:gap-3">
    <div class="relative hidden min-w-0 max-w-[15rem] flex-1 md:block" data-controller="global-search">
      <div class="relative">
        <input type="text"
               data-global-search-target="input"
               data-action="input->global-search#onInput keydown->global-search#onKeydown focus->global-search#onFocus"
               placeholder="<%= t("layouts.application.search.placeholder") %>"
               class="h-9 w-full rounded-lg border border-white/10 bg-[rgba(15,23,43,0.5)] py-2 pl-10 pr-4 text-sm font-normal text-slate-200 placeholder:text-[#90A1B9] focus:border-transparent focus:outline-none focus:ring-2 focus:ring-[#615FFF]"
               autocomplete="off">
        <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <button type="button"
                data-global-search-target="clearBtn"
                data-action="click->global-search#clear"
                class="absolute right-3 top-1/2 hidden -translate-y-1/2 text-slate-400 hover:text-white">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div data-global-search-target="results"
           class="absolute left-0 right-0 top-full z-50 mt-2 hidden max-h-96 overflow-y-auto rounded-lg border border-white/10 bg-[rgba(15,23,43,0.95)] shadow-xl">
        <div data-global-search-target="loading" class="hidden p-4 text-center text-slate-400">
          <svg class="mx-auto h-5 w-5 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span class="mt-1 block text-sm"><%= t("layouts.application.search.searching") %></span>
        </div>
        <div data-global-search-target="empty" class="hidden p-4 text-center text-sm text-slate-400">
          <%= t("layouts.application.search.no_results") %>
        </div>
        <div data-global-search-target="resultsList" class="divide-y divide-white/10"></div>
      </div>
    </div>

    <span class="hidden max-w-[11rem] truncate text-sm text-[#90A1B9] lg:inline"><%= t("layouts.application.nav.welcome_user", name: current_user.display_name) %></span>

    <%= button_to t("common.buttons.sign_out"), sign_out_path, method: :delete,
        form: { data: { turbo: false }, class: "shrink-0 [&_input]:whitespace-nowrap" },
        class: "shrink-0 cursor-pointer rounded-lg bg-theme-brand-gradient px-4 py-2 text-center text-base font-medium text-white transition-opacity hover:opacity-95 [&_input]:cursor-pointer [&_input]:border-0 [&_input]:bg-transparent [&_input]:p-0 [&_input]:text-inherit" %>
    <%= link_to billing_path, class: "shrink-0 whitespace-nowrap rounded-lg bg-theme-brand-gradient px-4 py-2 text-base font-medium text-white transition-opacity hover:opacity-95", data: { turbo: false } do %>
      <%= t("layouts.application.nav.my_billing") %>
    <% end %>

    <div class="relative shrink-0" data-controller="avatar-dropdown">
      <button type="button"
              data-action="click->avatar-dropdown#toggle"
              class="relative z-50 rounded-full transition-all hover:ring-2 hover:ring-[#7C86FF] focus:outline-none focus:ring-2 focus:ring-[#7C86FF]">
        <% if current_user.avatar.attached? %>
          <%= image_tag current_user.avatar,
              class: "h-12 w-12 rounded-full border-2 border-white/10 object-cover shadow-lg",
              alt: t("layouts.application.nav.profile_picture") %>
        <% else %>
          <div class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-white/10 bg-slate-700 shadow-lg">
            <svg class="h-7 w-7 text-slate-400" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
            </svg>
          </div>
        <% end %>
      </button>

      <div data-avatar-dropdown-target="menu"
           class="absolute right-0 hidden w-64 rounded-lg border border-white/10 bg-[rgba(15,23,43,0.95)] shadow-xl"
           style="top: 100%; margin-top: 0.5rem;">
        <div class="py-2">
          <button type="button"
                  data-action="click->avatar-dropdown#toggleLanguage"
                  class="w-full cursor-pointer px-4 py-2 text-left text-slate-300 transition-colors hover:bg-white/5">
            <div class="flex items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                </svg>
                <span><%= t("language_names.#{I18n.locale}", locale: :en, default: I18n.locale.to_s.upcase) %></span>
              </div>
              <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </div>
          </button>
          <div data-avatar-dropdown-target="languageMenu" class="hidden">
            <% I18n.available_locales.each do |loc| %>
              <a href="<%= url_for(request.query_parameters.merge(locale: loc)) %>"
                 data-turbo="false"
                 class="block py-2 pl-11 pr-4 text-sm transition-colors hover:bg-white/5 <%= I18n.locale == loc ? "font-semibold text-[#7C86FF]" : "text-slate-300" %>">
                <%= t("language_names.#{loc}", locale: :en, default: loc.to_s.upcase) %>
              </a>
            <% end %>
          </div>

          <div class="my-2 border-t border-white/10"></div>

          <%= link_to account_settings_path,
              class: "block px-4 py-2 text-slate-300 transition-colors hover:bg-white/5",
              data: { action: "click->avatar-dropdown#close" } do %>
            <div class="flex items-center gap-2">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <span><%= t("layouts.application.dropdown.account_settings") %></span>
            </div>
          <% end %>

          <%= link_to profile_settings_path,
              class: "block px-4 py-2 text-slate-300 transition-colors hover:bg-white/5",
              data: { action: "click->avatar-dropdown#close" } do %>
            <div class="flex items-center gap-2">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
              <span><%= t("layouts.application.dropdown.profile_settings") %></span>
            </div>
          <% end %>

          <%= link_to support_center_url,
              target: "_blank", rel: "noopener noreferrer",
              class: "block px-4 py-2 text-slate-300 transition-colors hover:bg-white/5",
              data: { action: "click->avatar-dropdown#close" } do %>
            <div class="flex items-center gap-2">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"></path>
              </svg>
              <span><%= t("sidebar.contact_support") %></span>
            </div>
          <% end %>

          <%= link_to support_center_url,
              target: "_blank", rel: "noopener noreferrer",
              class: "block px-4 py-2 text-slate-300 transition-colors hover:bg-white/5",
              data: { action: "click->avatar-dropdown#close" } do %>
            <div class="flex items-center gap-2">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
              </svg>
              <span><%= t("billing.show.contact_billing_team") %></span>
            </div>
          <% end %>

          <div class="my-2 border-t border-white/10"></div>

          <%= link_to support_center_url,
              target: "_blank", rel: "noopener noreferrer",
              class: "block px-4 py-2 text-slate-300 transition-colors hover:bg-white/5",
              data: { action: "click->avatar-dropdown#close" } do %>
            <div class="flex items-center gap-2">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              <span><%= t("layouts.application.dropdown.release_notes") %></span>
            </div>
          <% end %>
          <p class="px-4 pb-1 text-xs leading-relaxed text-slate-500"><%= t("layouts.application.dropdown.release_notes_instructions") %></p>

          <%= link_to roadmap_path,
              class: "block px-4 py-2 text-slate-300 transition-colors hover:bg-white/5",
              data: { action: "click->avatar-dropdown#close" } do %>
            <div class="flex items-center gap-2">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
              </svg>
              <span><%= t("layouts.application.dropdown.roadmap") %></span>
            </div>
          <% end %>

          <div class="mt-2 border-t border-white/10 px-4 pt-2 text-xs text-slate-500">
            <div class="flex items-center gap-2">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
              </svg>
              <span><%= t("layouts.application.dropdown.version", version: Rails.application.config.version || "1.0.0") %></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
