<div class="max-w-4xl mx-auto p-6">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-theme-primary mb-2"><%= t('loot_rolls.index.title') %></h1>
      <p class="text-theme-secondary"><%= t('loot_rolls.index.subtitle', guild_name: @guild.name) %></p>
    </div>
    <% if @guild.owner == current_user || can_manage_guild_settings?(@guild) %>
      <%= link_to t('loot_rolls.index.create_loot_roll'), new_guild_loot_roll_path(@guild), class: "px-6 py-3 bg-theme-accent text-white rounded-lg hover:bg-theme-accent-hover transition-colors font-semibold" %>
    <% end %>
  </div>

  <% if @loot_rolls.any? %>
    <div class="space-y-4">
      <% @loot_rolls.each do |loot_roll| %>
        <div class="bg-theme-secondary rounded-lg border border-theme-primary p-6">
          <div class="flex items-start justify-between mb-4">
            <div class="flex-1">
              <h3 class="text-xl font-semibold text-theme-primary mb-2">
                <%= link_to loot_roll.title, guild_loot_roll_path(@guild, loot_roll), class: "hover:text-theme-accent transition-colors" %>
              </h3>
              <% if loot_roll.description.present? %>
                <p class="text-theme-secondary mb-3 line-clamp-2"><%= truncate(loot_roll.description, length: 150) %></p>
              <% end %>
              <div class="flex items-center gap-4 text-sm text-theme-secondary flex-wrap">
                <span><%= t('loot_rolls.index.created_by', name: loot_roll.creator.name_for_discord_embed) %></span>
                <span>•</span>
                <span><%= t('loot_rolls.index.range') %> <%= loot_roll.min_roll %> - <%= loot_roll.max_roll %></span>
                <span>•</span>
                <span><%= loot_roll.total_entries %> <%= "roll".pluralize(loot_roll.total_entries) %></span>
                <% if loot_roll.deadline_at.present? %>
                  <span>•</span>
                  <span><%= t('loot_rolls.index.deadline') %> <%= loot_roll.deadline_at.strftime("%B %d, %Y at %I:%M %p") %></span>
                <% end %>
              </div>
            </div>
            <div class="ml-4">
              <span class="px-3 py-1 rounded-full text-sm font-medium
                <%= loot_roll.currently_open? ? 'bg-green-900/30 text-green-500' : 'bg-gray-900/30 text-gray-500' %>">
                <%= loot_roll.currently_open? ? t('loot_rolls.index.open') : t('loot_rolls.index.closed') %>
              </span>
            </div>
          </div>

          <% if loot_roll.total_entries > 0 %>
            <div class="mt-4 pt-4 border-t border-theme-primary">
              <div class="flex items-center gap-4">
                <% highest_roll = loot_roll.highest_roll %>
                <div class="flex items-center gap-2">
                  <span class="text-sm text-theme-secondary"><%= t('loot_rolls.index.highest_roll') %></span>
                  <span class="text-lg font-bold text-theme-accent"><%= highest_roll %></span>
                </div>
                <% if loot_roll.winner_entry.present? %>
                  <div class="flex items-center gap-2">
                    <span class="text-sm text-theme-secondary"><%= t('loot_rolls.index.winner') %></span>
                    <span class="text-lg font-bold text-yellow-500">
                      <%= loot_roll.winner_entry.display_name %>
                    </span>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

          <div class="mt-4 flex items-center gap-4">
            <%= link_to loot_roll.currently_open? ? t('loot_rolls.index.view_roll') : t('loot_rolls.index.view_results'), 
                guild_loot_roll_path(@guild, loot_roll), 
                class: "inline-block px-4 py-2 bg-theme-accent text-white rounded-lg hover:bg-theme-accent-hover transition-colors cursor-pointer" %>
            <% if loot_roll.creator == current_user || @guild.owner == current_user || can_manage_guild_settings?(@guild) %>
              <%= button_to t('loot_rolls.index.delete'), guild_loot_roll_path(@guild, loot_roll), method: :delete,
                  class: "px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors text-sm",
                  data: { confirm: t('loot_rolls.index.delete_confirm') } %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-theme-secondary rounded-lg border border-theme-primary p-8 text-center">
      <p class="text-theme-secondary text-lg mb-4"><%= t('loot_rolls.index.no_loot_rolls') %></p>
      <% if @guild.owner == current_user || can_manage_guild_settings?(@guild) %>
        <%= link_to t('loot_rolls.index.create_first'), new_guild_loot_roll_path(@guild), 
            class: "inline-block px-6 py-3 bg-theme-accent text-white rounded-lg hover:bg-theme-accent-hover transition-colors font-semibold" %>
      <% end %>
    </div>
  <% end %>
</div>
