# Environment Variables for GuildSync Integration Tests
#
# This file is for the Node/Playwright runner in external_tests/.
# Copy it to external_tests/.env when you need local runner overrides.
#
# Rails app/server environment belongs in ../guildsync/.env (template:
# ../guildsync/.env.example). Keep Rails secrets out of this file unless you
# intentionally want the test wrapper to pass them to a local Rails test server.
#
# The .env file is gitignored and should not be committed.

# Debug Options
# Set to 1 to enable debug logging for skip reasons in test reporters.
DEBUG_SKIP_REASONS=0

# Test Configuration
# Base URL for the Rails application (defaults to http://localhost:5000).
# BASE_URL=http://localhost:5000

# API Base URL (defaults to BASE_URL/api/v1).
# API_BASE_URL=http://localhost:5000/api/v1

# Automatic server management:
# If you change BASE_URL to another port and let the wrapper start Rails, keep
# PORT and APP_URL aligned so Puma and Rails URL helpers use the same local URL.
# PORT=5000
# APP_URL=http://localhost:5000

# Isolated Rails test server:
# Set these when you want `npm run test:*:with-server` to start Rails in test
# instead of development. CI sets these in .github/workflows/ci_playwright_github_hosted.yml.
# RAILS_ENV=test
# INTEGRATION_TESTS=1

# Optional: override the Rails app path if this repo is checked out differently.
# GUILDSYNC_SERVER_DIR=/absolute/path/to/GuildSync/guildsync

# After changing Rails JWT/Turnstile initializers, restart the test server so
# Playwright hits the new code. For unique failure counts, use Playwright JSON
# (test-results/results.json); text summaries repeat retries.
#
# Easiest fresh-code workflow:
#   npm ci
#   npx playwright install chromium
#   npm run test:with-server -- --yes --inline-server

# MFA Testing
# OTP secret for test users (used for MFA testing).
# TEST_MFA_SECRET=JBSWY3DPEHPK3PXP

# Default test OTP secret (fallback if TEST_MFA_SECRET is not set).
# TEST_MFA_SECRET_DEFAULT=JBSWY3DPEHPK3PXP

# Playwright Configuration
# Set to 1 to auto-open HTML report on failure for full suite runs.
# PLAYWRIGHT_FULL_SUITE=0

# Discord Credentials
# DISCORD_CREDENTIALS=USERNAME:PASSWORD
