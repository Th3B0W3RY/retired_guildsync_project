<%# locals: (user:) %>
<% ns = "admin.ocr_requests.show" %>
<div id="admin_ocr_user_actions_panel" class="bg-theme-card border border-theme-primary rounded-lg p-6 shadow-lg">
  <h2 class="text-xl font-semibold mb-4"><%= t("#{ns}.actions_heading") %></h2>
  <div class="flex flex-wrap gap-4">
    <%= button_to t("#{ns}.hard_lock_ocr"), admin_ocr_request_toggle_lock_path(user), method: :post, class: "px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700" if !user.ocr_hard_locked? %>
    <%= button_to t("#{ns}.unlock_ocr"), admin_ocr_request_toggle_lock_path(user), method: :post, class: "px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700" if user.ocr_hard_locked? %>
    <%= button_to (user.ocr_unlocked? ? t("#{ns}.revoke_unlock_override") : t("#{ns}.grant_unlock_override")), admin_ocr_request_toggle_unlock_path(user), method: :post, class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
    <%= button_to t("#{ns}.reset_monthly_counter"), admin_ocr_request_reset_period_path(user), method: :post, data: { turbo_confirm: t("#{ns}.confirm_reset_monthly") }, class: "px-4 py-2 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700" %>
  </div>

  <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <h3 class="font-semibold mb-2"><%= t("#{ns}.adjust_heading") %></h3>
      <%= form_with url: admin_ocr_request_adjust_path(user), method: :post do |f| %>
        <%= f.number_field :delta, value: 1, min: -9999, max: 9999, class: "w-24 px-2 py-1 bg-theme-secondary border border-theme-primary rounded text-theme-primary" %>
        <%= f.text_field :reason, placeholder: t("#{ns}.reason_placeholder"), required: true, class: "flex-1 min-w-[200px] px-2 py-1 bg-theme-secondary border border-theme-primary rounded text-theme-primary ml-2" %>
        <%= f.submit t("#{ns}.apply"), class: "ml-2 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
      <% end %>
    </div>
    <div>
      <h3 class="font-semibold mb-2"><%= t("#{ns}.notes_heading") %></h3>
      <%= form_with url: admin_ocr_request_notes_path(user), method: :patch do |f| %>
        <%= f.text_area :ocr_notes, value: user.ocr_notes, rows: 3, class: "w-full px-2 py-1 bg-theme-secondary border border-theme-primary rounded text-theme-primary" %>
        <%= f.submit t("#{ns}.save_notes"), class: "mt-2 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
      <% end %>
    </div>
  </div>
</div>
