<div class="space-y-6">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-3xl font-bold text-theme-accent"><%= t("admin.beta_features.title") %></h1>
    <%= link_to t("admin.dashboard.title"), admin_root_path, class: "text-theme-secondary hover:text-theme-accent" %>
  </div>

  <p class="text-theme-secondary text-sm max-w-3xl"><%= t("admin.beta_features.intro") %></p>

  <div id="admin_beta_features_flash" class="min-h-0" aria-live="polite"></div>

  <div class="flex flex-wrap gap-3 items-end">
    <%= form_with url: admin_beta_features_path, method: :get,
        data: { turbo_frame: Admin::BetaFeaturesController::BETA_FEATURES_RESULTS_FRAME },
        class: "flex flex-wrap gap-3 items-end" do %>
      <div>
        <label for="q" class="block text-sm text-theme-secondary mb-1"><%= t("admin.beta_features.search") %></label>
        <input type="search" name="q" id="q" value="<%= @q %>" placeholder="<%= t("admin.beta_features.search_placeholder") %>" class="px-3 py-2 bg-theme-primary border border-theme-primary rounded-lg text-theme-primary min-w-[16rem]" />
      </div>
      <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium"><%= t("admin.beta_features.apply") %></button>
    <% end %>
    <%= link_to t("admin.users.index.clear"), admin_beta_features_path,
      class: "px-4 py-2 bg-theme-secondary text-theme-primary rounded-lg hover:bg-theme-hover transition-colors mb-0",
      data: { turbo_frame: Admin::BetaFeaturesController::BETA_FEATURES_RESULTS_FRAME } %>
  </div>

  <%= turbo_frame_tag Admin::BetaFeaturesController::BETA_FEATURES_RESULTS_FRAME do %>
    <%= render "beta_features_results" %>
  <% end %>
</div>
