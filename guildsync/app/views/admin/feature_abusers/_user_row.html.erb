<%# locals: (user:) %>
<% warn = user.user_compliance_warnings.find { |w| w.warning_type == UserComplianceWarning::WARNING_TYPE_IP_CONFLICT && w.active? } %>
<tr id="admin_feature_abuser_row_<%= user.id %>" class="hover:bg-theme-secondary/40">
  <td class="px-4 py-3 text-theme-secondary"><%= user.id %></td>
  <td class="px-4 py-3 text-theme-primary"><%= user.username %></td>
  <td class="px-4 py-3 text-theme-secondary"><%= user.email %></td>
  <td class="px-4 py-3"><%= user.locked_at.present? ? t("admin.feature_abusers.yes") : t("admin.feature_abusers.no") %></td>
  <td class="px-4 py-3"><%= warn ? t("admin.feature_abusers.yes") : t("admin.feature_abusers.no") %></td>
  <td class="px-4 py-3 flex flex-wrap gap-2">
    <%= button_to t("admin.feature_abusers.lock"), admin_feature_abuser_lock_path(user_id: user.id), method: :post, class: "px-3 py-1 bg-red-900/40 border border-red-500/40 rounded text-red-300 text-xs hover:bg-red-900/60", form: { data: { turbo_frame: "_top" } } %>
    <%= button_to t("admin.feature_abusers.unlock"), admin_feature_abuser_unlock_path(user_id: user.id), method: :post, class: "px-3 py-1 bg-green-900/40 border border-green-500/40 rounded text-green-300 text-xs hover:bg-green-900/60", form: { data: { turbo_frame: "_top" } } %>
    <%= link_to t("admin.feature_abusers.view_user"), admin_user_path(user), class: "text-theme-accent text-xs", data: { turbo_frame: "_top" } %>
  </td>
</tr>
