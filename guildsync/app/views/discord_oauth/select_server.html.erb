<% if params[:popup].present? %>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      background: #1a1a1a;
      color: #ffffff;
      margin: 0;
      padding: 20px;
    }
    .server-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 16px;
      margin-top: 20px;
    }
    .server-card {
      background: #2a2a2a;
      border: 2px solid #3a3a3a;
      border-radius: 8px;
      padding: 16px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .server-card:hover {
      border-color: #5865F2;
      background: #2f2f3a;
    }
    .server-card .icon {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      margin-bottom: 12px;
    }
    .server-card .icon-placeholder {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: #5865F2;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      font-weight: bold;
      margin-bottom: 12px;
    }
    .server-card h3 {
      margin: 0 0 8px 0;
      font-size: 18px;
    }
    .server-card .role {
      font-size: 14px;
      color: #888;
    }
    .server-card .role.owner {
      color: #44ff44;
    }
    .error-message {
      background: #3a1a1a;
      border: 1px solid #ff4444;
      border-radius: 8px;
      padding: 16px;
      text-align: center;
      color: #ff4444;
    }
  </style>
<% end %>

<div class="<%= params[:popup].present? ? '' : 'max-w-4xl mx-auto p-6' %>">
  <div class="mb-6">
    <h1 class="<%= params[:popup].present? ? 'text-2xl' : 'text-3xl' %> font-bold text-theme-primary mb-2"><%= t('discord_oauth.select_server.title') %></h1>
    <p class="text-theme-secondary"><%= t('discord_oauth.select_server.subtitle', name: @guild.name) %></p>
  </div>

  <% if @discord_guilds.any? %>
    <div class="<%= params[:popup].present? ? 'server-grid' : 'grid grid-cols-1 md:grid-cols-2 gap-4' %>">
      <% @discord_guilds.each do |guild| %>
        <div class="<%= params[:popup].present? ? 'server-card' : 'bg-theme-secondary rounded-lg border border-theme-primary p-4 hover:border-theme-accent transition-colors cursor-pointer' %>" 
             onclick="selectServer('<%= guild['id'] %>')">
          <div class="<%= params[:popup].present? ? '' : 'flex items-center gap-4' %>">
            <% if guild['icon'] %>
              <img src="https://cdn.discordapp.com/icons/<%= guild['id'] %>/<%= guild['icon'] %>.png" 
                   alt="<%= guild['name'] %>" 
                   class="<%= params[:popup].present? ? 'icon' : 'w-16 h-16 rounded-full' %>">
            <% else %>
              <div class="<%= params[:popup].present? ? 'icon-placeholder' : 'w-16 h-16 rounded-full bg-theme-primary flex items-center justify-center text-2xl font-bold text-theme-accent' %>">
                <%= guild['name'][0].upcase %>
              </div>
            <% end %>
            <div class="<%= params[:popup].present? ? '' : 'flex-1' %>">
              <h3 class="<%= params[:popup].present? ? '' : 'text-lg' %> font-semibold text-theme-primary"><%= guild['name'] %></h3>
              <p class="<%= params[:popup].present? ? 'role' : 'text-sm' %> text-theme-secondary <%= 'owner' if guild['owner'] %>">
                <% if guild['owner'] %>
                  <span class="<%= params[:popup].present? ? '' : 'text-green-500' %>"><%= t('discord_oauth.select_server.owner') %></span>
                <% else %>
                  <span><%= t('discord_oauth.select_server.member') %></span>
                <% end %>
              </p>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <form id="server-form" action="<%= discord_connect_server_path(guild_id: @guild.id, popup: params[:popup]) %>" method="post" class="hidden">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      <input type="hidden" name="discord_guild_id" id="selected-guild-id">
      <% if params[:popup].present? %>
        <input type="hidden" name="popup" value="true">
      <% end %>
    </form>
  <% else %>
    <div class="<%= params[:popup].present? ? 'error-message' : 'bg-theme-secondary rounded-lg border border-theme-primary p-6 text-center' %>">
      <p class="text-theme-secondary mb-4"><%= t('discord_oauth.select_server.no_servers') %></p>
      <p class="text-theme-secondary mb-6"><%= t('discord_oauth.select_server.no_servers_hint') %></p>
      <% unless params[:popup].present? %>
        <%= link_to t('discord_oauth.select_server.try_again'), guild_connect_discord_path(@guild), class: "px-6 py-2 bg-theme-accent text-white rounded-lg hover:bg-theme-accent-hover transition-colors font-semibold" %>
      <% end %>
    </div>
  <% end %>
</div>

<script>
  function selectServer(guildId) {
    document.getElementById('selected-guild-id').value = guildId;
    document.getElementById('server-form').submit();
  }
</script>
