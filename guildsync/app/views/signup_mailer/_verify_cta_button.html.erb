<%# Bulletproof CTA: table wrapper helps Outlook/Gmail reliably expose the same href as the plain URL. %>
<% url = @verify_url.to_s.strip %>
<table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 24px 0;">
  <tr>
    <td style="border-radius: 8px; background-color: #6366f1;">
      <a href="<%= url %>" style="display: inline-block; background-color: #6366f1; color: #ffffff; text-decoration: none; font-weight: 600; padding: 12px 24px; border-radius: 8px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;"><%= cta_text %></a>
    </td>
  </tr>
</table>
