<div class="space-y-8">
  <div class="flex justify-between items-center">
    <h1 class="text-3xl font-bold text-theme-accent"><%= t("admin.games.pending.page_title") %></h1>
    <%= link_to t("admin.users.index.back_to_dashboard"), admin_root_path, class: "px-4 py-2 bg-theme-secondary text-theme-primary rounded-lg hover:bg-theme-hover transition-colors" %>
  </div>

  <div id="admin_games_pending_flash" class="min-h-0" aria-live="polite"></div>

  <%= turbo_frame_tag Admin::GamesController::GAMES_PENDING_MAIN_FRAME do %>
    <div id="admin_games_pending_content">
      <%= render "admin/games/pending_content", pending_games: @pending_games %>
    </div>
  <% end %>
</div>
