<div class="space-y-6">
  <div class="flex justify-between items-center">
    <h1 class="text-3xl font-bold text-theme-accent"><%= t("roadmap.admin.panel_title") %></h1>
    <%= link_to t("roadmap.title"), roadmap_path, target: "_blank", rel: "noopener noreferrer", class: "px-4 py-2 bg-theme-secondary text-theme-primary rounded-lg hover:bg-theme-hover" %>
  </div>

  <%# Search %>
  <%= form_with url: admin_feature_requests_path, method: :get, local: true, class: "flex gap-2", data: { turbo: false } do |f| %>
    <%= f.text_field :q, value: @search, placeholder: t("roadmap.search_placeholder"), class: "flex-1 px-4 py-2 bg-theme-primary border border-theme-primary rounded-lg text-theme-primary" %>
    <%= f.submit "Search", class: "px-4 py-2 bg-theme-accent text-white rounded-lg hover:bg-theme-accent-hover cursor-pointer" %>
  <% end %>

  <%= turbo_frame_tag Admin::FeatureRequestsController::FEATURE_REQUESTS_INDEX_MAIN_FRAME do %>
    <%= render "feature_requests_index_main" %>
  <% end %>
</div>
