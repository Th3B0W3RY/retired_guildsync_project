source "https://rubygems.org"

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
gem "rails", "~> 8.0.2"
# Use postgresql as the database for Active Record
gem "pg", "~> 1.1"
# Use the Puma web server [https://github.com/puma/puma]
gem "puma", ">= 6.0"
# Build JSON APIs with ease [https://github.com/rails/jbuilder]
# gem "jbuilder"

# Use bcrypt for password and backup-code digests.
gem "bcrypt", "~> 3.1"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ windows jruby ]

# Use the database-backed adapter for Rails.cache (ActionCable uses Redis in production; SolidCable/solid_queue removed to avoid Puma boot crash)
gem "solid_cache"

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

# Add HTTP asset caching/compression and X-Sendfile acceleration to Puma [https://github.com/basecamp/thruster/]
gem "thruster", require: false

# Use Active Storage variants [https://guides.rubyonrails.org/active_storage_overview.html#transforming-images]
gem "image_processing", "~> 1.2"
# S3-compatible storage backend for Active Storage (AWS, Hetzner, etc.)
gem "aws-sdk-s3", ">= 1.136", require: false

# OCR - Optional fallback to Tesseract (Surya OCR is primary, uses Python)
gem "rtesseract"  # Tesseract OCR fallback option

# Use Rack CORS for handling Cross-Origin Resource Sharing (CORS), making cross-origin Ajax possible
gem "rack-cors"

# Authentication
gem "devise"
gem "devise-jwt"

# Authorization
gem "pundit"

# JSON Serialization
gem "blueprinter"
gem "oj"

# Background Jobs
gem "sidekiq", "~> 7.0"
gem "redis", "~> 5.0"
gem "csv"

# Payment Processing
gem "stripe", "~> 10.0"

# Security
gem "rack-attack"
gem "secure_headers"

# Multi-Factor Authentication
gem "rotp"  # TOTP (Time-based One-Time Password) generation
gem "rqrcode"  # QR code generation for MFA setup
gem "chunky_png"  # PNG generation for QR codes

# Environment variables
gem "dotenv-rails"

# Discord Integration
gem "rest-client"  # For Discord API HTTP requests
gem "discordrb"  # Discord bot library (optional, for bot functionality)
gem "rbnacl"  # For Ed25519 signature verification (Discord interactions)

# Search
gem "typesense"  # Typesense client for search

# Add logging with rotation support
gem "logging"

# Internationalization - browser Accept-Language header parsing
gem "http_accept_language"

# CSS Framework
gem "tailwindcss-rails"
gem "sprockets-rails"  # Required by tailwindcss-rails for asset pipeline

# JavaScript
gem "jsbundling-rails"
gem "turbo-rails"
# gem "importmap-rails" # Removed - using esbuild instead

group :development, :test do
  # See https://guides.rubyonrails.org/debugging_rails_applications.html#debugging-with-the-debug-gem
  gem "debug", platforms: %i[ mri windows ], require: false

  # Static analysis for security vulnerabilities [https://brakemanscanner.org/]
  gem "brakeman", require: false

  # Omakase Ruby styling [https://github.com/rails/rubocop-rails-omakase/]
  gem "rubocop-rails-omakase", require: false

  # Find missing/unused translations; run: bundle exec i18n-tasks health
  gem "i18n-tasks", "~> 1.0", require: false
end

group :test do
  gem "rspec-rails"
  gem "factory_bot_rails"
  gem "faker"
  gem "pundit-matchers"
  gem "webmock"
  gem "rails-controller-testing"
  gem "simplecov", require: false
  gem "rspec_junit_formatter"
end
