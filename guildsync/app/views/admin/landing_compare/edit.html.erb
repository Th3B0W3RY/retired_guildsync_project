<div class="space-y-8 max-w-4xl">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold text-theme-accent"><%= t("admin.landing_compare.page_title") %></h1>
      <p class="text-theme-secondary mt-2"><%= t("admin.landing_compare.page_subtitle") %></p>
    </div>
    <%= link_to t("admin.landing_compare.back_dashboard"), admin_root_path,
          class: "px-4 py-2 bg-theme-secondary text-theme-accent border border-theme-primary rounded-lg hover:bg-theme-hover font-medium",
          data: { turbo_frame: "_top" } %>
  </div>

  <%= turbo_frame_tag Admin::LandingCompareController::LANDING_COMPARE_EDIT_MAIN_FRAME do %>
    <%= render "landing_compare_main" %>
  <% end %>
</div>
