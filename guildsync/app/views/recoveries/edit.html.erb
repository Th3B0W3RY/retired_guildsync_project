<div class="max-w-md mx-auto">
  <h1 class="text-3xl font-bold text-theme-primary mb-4"><%= t('recoveries.edit.title') %></h1>
  <div class="mb-4">
    <span class="inline-block px-4 py-1.5 bg-amber-600 text-white rounded-full text-sm font-medium">
      <%= t('recoveries.edit.badge') %>
    </span>
  </div>

  <%= form_with model: @user, url: recover_account_path, method: :put, local: true, class: "space-y-6" do |f| %>
    <div class="space-y-4">
      <h3 class="text-lg font-semibold text-theme-primary">1. Set New Password</h3>
      <div>
        <%= f.label :password, t('recoveries.edit.new_password'), class: "block mb-2 text-theme-secondary font-medium" %>
        <%= f.password_field :password, required: true, autocomplete: "new-password",
            minlength: Devise.password_length.first,
            class: "w-full px-4 py-3 bg-theme-secondary border border-theme-primary rounded-lg text-theme-primary focus:outline-none focus:ring-2 focus:ring-theme-accent focus:border-transparent transition-all" %>
        <p class="mt-1 text-sm text-theme-secondary"><%= t('passwords.edit.password_hint') %></p>
      </div>
      <div>
        <%= f.label :password_confirmation, t('recoveries.edit.confirm_password'), class: "block mb-2 text-theme-secondary font-medium" %>
        <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password",
            class: "w-full px-4 py-3 bg-theme-secondary border border-theme-primary rounded-lg text-theme-primary focus:outline-none focus:ring-2 focus:ring-theme-accent focus:border-transparent transition-all" %>
      </div>
    </div>

    <div class="space-y-4 pt-4 border-t border-theme-primary">
      <h3 class="text-lg font-semibold text-theme-primary">2. <%= t('recoveries.edit.mfa_section') %></h3>
      <% if @user.mfa_enabled? %>
        <div class="p-4 bg-red-900/20 border border-red-700/50 rounded-lg text-red-200 text-sm">
          <%= t('recoveries.edit.mfa_warning') %>
        </div>
        <div class="flex items-center gap-2">
          <%= check_box_tag :reset_mfa, "1", true, class: "rounded border-theme-primary text-theme-accent focus:ring-theme-accent" %>
          <%= label_tag :reset_mfa, t('recoveries.edit.reset_mfa_label'), class: "text-theme-primary" %>
        </div>
      <% else %>
        <p class="text-theme-secondary"><%= t('recoveries.edit.mfa_not_enabled') %></p>
        <%= hidden_field_tag :reset_mfa, "0" %>
      <% end %>
    </div>

    <% if @user.errors.any? %>
      <div class="p-4 bg-red-900/50 border border-red-700 text-red-100 rounded-lg">
        <ul class="list-disc list-inside space-y-1 text-sm">
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.submit t('recoveries.edit.submit'),
          class: "w-full px-4 py-3 bg-amber-600 text-white rounded-lg hover:bg-amber-700 transition-colors cursor-pointer font-semibold text-lg shadow-lg" %>
    </div>
  <% end %>

  <p class="mt-6 text-sm text-theme-secondary">
    <%= t('recoveries.edit.note') %>
  </p>

  <div class="mt-8 pt-6 border-t border-theme-primary">
    <p class="text-theme-secondary text-center">
      <%= link_to t('passwords.edit.back_to_sign_in'), login_path, class: "text-theme-accent hover:text-dark-accent-hover font-medium underline" %>
    </p>
  </div>
</div>
