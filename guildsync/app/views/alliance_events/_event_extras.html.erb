<%# Optional Discord parity fields for alliance events (form builder: f) %>
<div>
  <%= f.label :event_type, t("alliances.events.form.event_type"), class: "block text-sm font-medium text-theme-primary mb-2" %>
  <%= f.select :event_type,
        options_for_select(
          AllianceEvent::EVENT_TYPE_OPTIONS,
          @event.event_type.presence
        ),
        { include_blank: t("alliances.events.form.event_type_general") },
        class: "gs-native-select gs-native-select--field w-full px-4 bg-theme-primary border border-theme-secondary rounded-lg text-theme-primary" %>
</div>

<div class="grid grid-cols-2 gap-4">
  <div>
    <%= f.label :max_participants, t("alliances.events.form.max_participants"), class: "block text-sm font-medium text-theme-primary mb-2" %>
    <%= f.number_field :max_participants, min: 1, class: "w-full px-4 py-2 bg-theme-primary border border-theme-secondary rounded-lg text-theme-primary" %>
  </div>
  <div>
    <%= f.label :squad_leader, t("alliances.events.form.squad_leader"), class: "block text-sm font-medium text-theme-primary mb-2" %>
    <%= f.text_field :squad_leader, class: "w-full px-4 py-2 bg-theme-primary border border-theme-secondary rounded-lg text-theme-primary", placeholder: t("alliances.events.form.squad_leader_placeholder") %>
  </div>
</div>

<% role_vals = Array(@event.role_categories).map(&:to_s) %>
<% role_vals = AllianceDiscordBroadcastService::ROLE_CATEGORIES if role_vals.empty? %>
<div>
  <p class="block text-sm font-medium text-theme-primary mb-2"><%= t("alliances.events.form.role_categories_section") %></p>
  <p class="text-xs text-theme-secondary mb-3"><%= t("alliances.events.form.role_categories_hint") %></p>
  <div class="flex flex-wrap gap-4">
    <% AllianceDiscordBroadcastService::ROLE_CATEGORIES.each do |role| %>
      <label class="inline-flex items-center gap-2 cursor-pointer">
        <%= check_box_tag "alliance_event[role_categories][]", role, role_vals.include?(role), class: "rounded border-theme-secondary" %>
        <span class="text-theme-primary"><%= role.upcase %></span>
      </label>
    <% end %>
  </div>
  <%= hidden_field_tag "alliance_event[role_categories][]", "" %>
</div>
