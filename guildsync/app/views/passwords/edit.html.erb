<div class="max-w-md mx-auto">
  <h1 class="text-3xl font-bold text-theme-primary mb-4"><%= t('passwords.edit.title') %></h1>
  <p class="text-theme-secondary mb-8"><%= t('passwords.edit.subtitle') %></p>

  <%= form_with model: @user, url: password_path, method: :patch, local: true, data: { turbo: false }, class: "space-y-6" do |f| %>
    <%= f.hidden_field :reset_password_token, value: @reset_password_token %>
    
    <% if @user.errors.any? %>
      <div class="p-4 bg-red-900/50 border border-red-700 text-red-100 rounded-lg mb-4">
        <ul class="list-disc list-inside space-y-1">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :password, t('passwords.edit.new_password'), class: "block mb-2 text-theme-secondary font-medium" %>
      <%= f.password_field :password, required: true, autofocus: true, autocomplete: "new-password",
          minlength: Devise.password_length.first,
          class: "w-full px-4 py-3 bg-theme-secondary border border-theme-primary rounded-lg text-theme-primary focus:outline-none focus:ring-2 focus:ring-theme-accent focus:border-transparent transition-all" %>
      <p class="mt-1 text-sm text-theme-secondary"><%= t('passwords.edit.password_hint') %></p>
    </div>
    
    <div>
      <%= f.label :password_confirmation, t('passwords.edit.confirm_new_password'), class: "block mb-2 text-theme-secondary font-medium" %>
      <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password",
          class: "w-full px-4 py-3 bg-theme-secondary border border-theme-primary rounded-lg text-theme-primary focus:outline-none focus:ring-2 focus:ring-theme-accent focus:border-transparent transition-all" %>
    </div>
    
    <div>
      <%= f.submit t('passwords.edit.reset_password'), 
          class: "w-full px-4 py-3 bg-theme-accent text-white rounded-lg hover:bg-theme-accent-hover transition-colors cursor-pointer font-semibold text-lg shadow-lg" %>
    </div>
  <% end %>

  <div class="mt-8 pt-6 border-t border-theme-primary">
    <p class="text-theme-secondary text-center">
      <%= link_to t('passwords.edit.back_to_sign_in'), login_path, class: "text-theme-accent hover:text-dark-accent-hover font-medium underline" %>
    </p>
  </div>
</div>

