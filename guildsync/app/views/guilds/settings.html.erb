                <span class="text-theme-primary"><%= t('guilds.settings.permissions.can_edit_gear_scanned_stats', default: 'Can Edit Scanned Gear Stats') %></span>
              </label>
            </div>
          </div>
        </div>

        <div class="flex gap-4">
          <%= f.submit t('guilds.settings.permissions.save_button'), class: "px-6 py-3 bg-theme-accent text-white rounded-lg hover:bg-theme-accent-hover transition-colors font-semibold cursor-pointer" %>
          <%= link_to t('common.buttons.cancel'), guild_path(@guild), class: "px-6 py-3 bg-theme-secondary text-theme-primary rounded-lg hover:bg-theme-primary transition-colors font-semibold" %>
        </div>
      <% end %>

      <!-- Default Role Setting -->
      <%= form_with model: @guild, url: update_guild_path(@guild), method: :patch, local: true, class: "mt-6 space-y-4" do |f| %>
        <h3 class="text-lg font-semibold text-theme-primary"><%= t('guilds.settings.permissions.default_role.title') %></h3>
        <p class="text-sm text-theme-secondary mb-4"><%= t('guilds.settings.permissions.default_role.description') %></p>
        <div>
          <%= f.label :default_role_id, t('guilds.settings.permissions.default_role.label'), class: "block text-sm font-medium text-theme-primary mb-2" %>
          <%= f.select :default_role_id,
              options_for_select([[t('guilds.settings.permissions.none'), ""]] + @synced_roles.map { |r| [r.role_name, r.role_id] }, @guild.default_role_id),
              {},
              { class: "gs-native-select gs-native-select--field w-full px-4 bg-theme-primary border border-theme-secondary rounded-lg text-theme-primary" } %>
        </div>
        <div class="flex gap-4">
          <%= f.submit t('guilds.settings.permissions.default_role.save_button'), class: "px-6 py-3 bg-theme-accent text-white rounded-lg hover:bg-theme-accent-hover transition-colors font-semibold cursor-pointer" %>
          <%= link_to t('common.buttons.cancel'), guild_path(@guild), class: "px-6 py-3 bg-theme-secondary text-theme-primary rounded-lg hover:bg-theme-primary transition-colors font-semibold" %>
        </div>
      <% end %>
    </div>
  <% end %>
  <% end %>

  <!-- React Roles Configuration -->
  <% if can_manage_guild_settings?(@guild) && @discord_setting&.connected? && @bot_connected %>
    <div class="bg-theme-secondary rounded-lg border border-theme-primary p-6 mb-6"
         data-controller="react-roles"
         data-react-roles-guild-id-value="<%= @guild.id %>"
         data-react-roles-emojis-url-value="<%= guild_react_roles_emojis_path(@guild) %>">

      <h2 class="text-xl font-semibold text-theme-primary mb-2"><%= t('guilds.settings.react_roles.title') %></h2>
      <p class="text-theme-secondary mb-6"><%= t('guilds.settings.react_roles.description') %></p>

      <%# Channel selector %>
      <div class="mb-6">
        <label class="block text-sm font-medium text-theme-primary mb-2">
          <%= t('guilds.settings.react_roles.channel_label') %>
        </label>
        <% current_channel_id = @react_roles.first&.channel_id %>
        <select name="react_roles_channel_id"
                data-react-roles-target="channelSelect"
                class="gs-native-select gs-native-select--field w-full md:w-1/2 px-4 bg-theme-primary border border-theme-secondary rounded-lg text-theme-primary">
          <option value=""><%= t('guilds.settings.react_roles.select_channel') %></option>
          <% @channels.each do |channel| %>
            <option value="<%= channel["id"] %>" <%= "selected" if channel["id"] == current_channel_id %>>
              #<%= channel["name"] %>
            </option>
          <% end %>
        </select>
      </div>

      <%# 3 React Role slots %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
        <% (1..3).each do |position| %>
          <% rr = @react_roles.find { |r| r.position == position } %>
          <div class="bg-theme-primary rounded-lg border border-theme-secondary p-4 space-y-4"
               data-react-roles-target="slot"
               data-position="<%= position %>">

            <h3 class="font-semibold text-theme-primary">
              <%= t('guilds.settings.react_roles.slot_title', n: position) %>
            </h3>

            <%# Role dropdown %>
            <div>
              <label class="block text-sm font-medium text-theme-primary mb-1">
                <%= t('guilds.settings.react_roles.role_label') %>
              </label>
              <select data-react-roles-target="roleSelect"
                      class="gs-native-select gs-native-select--field w-full px-3 bg-theme-secondary border border-theme-primary rounded-lg text-theme-primary text-sm">
                <option value=""><%= t('guilds.settings.react_roles.select_role') %></option>
                <% @synced_roles.each do |role| %>
                  <option value="<%= role.role_id %>"
                          data-role-name="<%= role.role_name %>"
                          <%= "selected" if role.role_id == rr&.role_id %>>
                    <%= role.role_name %>
                  </option>
                <% end %>
              </select>
            </div>

            <%# Emoji selector %>
            <div>
              <label class="block text-sm font-medium text-theme-primary mb-1">
                <%= t('guilds.settings.react_roles.emoji_label') %>
              </label>
              <div class="relative">
                <button type="button"
                        data-action="click->react-roles#togglePicker"
                        data-react-roles-target="emojiButton"
                        class="w-full flex items-center gap-2 px-3 py-2 bg-theme-secondary border border-theme-primary rounded-lg text-theme-primary text-sm hover:border-theme-accent transition-colors">
                  <span data-react-roles-target="emojiDisplay" class="text-xl">
                    <%= rr&.display_emoji || "➕" %>
                  </span>
                  <span data-react-roles-target="emojiLabel" class="text-theme-secondary">
                    <%= rr ? rr.emoji_name : t('guilds.settings.react_roles.select_emoji') %>
                  </span>
                </button>

                <%# Hidden fields storing selected emoji metadata %>
                <input type="hidden" data-react-roles-target="emojiName"  value="<%= rr&.emoji_name %>">
                <input type="hidden" data-react-roles-target="emojiId"    value="<%= rr&.emoji_id %>">
                <input type="hidden" data-react-roles-target="emojiCustom" value="<%= rr&.is_custom_emoji? ? "1" : "0" %>">

                <%# Emoji picker dropdown (hidden until toggled) %>
                <div data-react-roles-target="picker"
                     class="hidden absolute z-50 top-full left-0 mt-1 w-72 bg-theme-primary border border-theme-secondary rounded-lg shadow-xl p-3">

                  <%# Custom server emojis (loaded dynamically via JS) %>
                  <div class="mb-3">
                    <p class="text-xs font-semibold text-theme-secondary mb-2 uppercase tracking-wide">
                      <%= t('guilds.settings.react_roles.server_emojis') %>
                    </p>
                    <div data-react-roles-target="customEmojis"
                         class="flex flex-wrap gap-1 min-h-6">
                      <span class="text-xs text-theme-secondary"><%= t('guilds.settings.react_roles.loading_emojis') %></span>
                    </div>
                  </div>

                  <%# Standard unicode emojis – curated common set %>
                  <div>
                    <p class="text-xs font-semibold text-theme-secondary mb-2 uppercase tracking-wide">
                      <%= t('guilds.settings.react_roles.standard_emojis') %>
                    </p>
                    <div class="flex flex-wrap gap-1 max-h-36 overflow-y-auto"
                         data-react-roles-target="unicodeEmojis">
                    </div>
                  </div>
                </div>
              </div>
              <p class="text-xs text-theme-secondary mt-1"><%= t('guilds.settings.react_roles.emoji_hint') %></p>
            </div>
          </div>
        <% end %>
      </div>

      <%# Action buttons %>
      <div class="flex flex-wrap gap-3">
        <button type="button"
                data-action="click->react-roles#save"
                class="px-6 py-2 bg-theme-accent text-white rounded-lg hover:bg-theme-accent-hover transition-colors font-semibold text-sm">
          <%= t('guilds.settings.react_roles.save_button') %>
        </button>

        <%= button_to t('guilds.settings.react_roles.deploy_button'),
              guild_react_roles_deploy_path(@guild),
              method: :post,
              class: "px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors font-semibold text-sm",
              data: { turbo: false } %>

        <% if @react_roles.any? %>
          <%= button_to t('guilds.settings.react_roles.remove_button'),
                guild_react_roles_destroy_path(@guild),
                method: :delete,
                class: "px-6 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors font-semibold text-sm",
                data: { turbo: false, confirm: t('guilds.settings.react_roles.remove_confirm') } %>
        <% end %>

        <%= link_to t('common.buttons.cancel'), guild_settings_path(@guild),
              class: "px-6 py-2 bg-theme-secondary text-theme-primary rounded-lg hover:bg-theme-primary transition-colors font-semibold text-sm" %>
      </div>

      <%# Flash-style save feedback rendered by Stimulus %>
      <div data-react-roles-target="feedback" class="hidden mt-3 text-sm font-medium"></div>

      <%# Bot role position notice %>
      <div class="mt-4 flex items-start gap-2 rounded-lg border border-yellow-400/30 bg-yellow-400/10 px-4 py-3 text-sm text-yellow-300">
        <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
        </svg>
        <span>
          For role assignment to work, the <strong>GuildSync</strong> bot must be positioned at the very top of your server's role hierarchy in Discord. Roles above the bot cannot be assigned or removed.
        </span>
      </div>
    </div>
  <% end %>

  <% if @guild.owner_id == current_user.id %>
    <div class="bg-red-950/20 rounded-lg border border-red-500 p-6 mb-6">
      <h2 class="text-xl font-semibold text-red-300 mb-2"><%= t("guild_archives.settings.title") %></h2>
      <p class="text-sm text-red-200 mb-4"><%= t("guild_archives.settings.warning") %></p>
      <p class="text-sm text-theme-secondary mb-4"><%= t("guild_archives.settings.type_name_hint", guild_name: @guild.name) %></p>

      <%= form_with url: archive_guild_path(@guild), method: :post, local: true, class: "space-y-4" do |f| %>
        <div>
          <%= f.label :guild_name_confirmation, t("guild_archives.settings.confirmation_label"), class: "block text-sm font-medium text-theme-primary mb-2" %>
          <%= f.text_field :guild_name_confirmation,
                           class: "w-full md:w-96 px-4 py-2 bg-theme-primary border border-theme-secondary rounded-lg text-theme-primary",
                           placeholder: @guild.name,
                           autocomplete: "off" %>
        </div>
        <div>
          <%= f.submit t("guild_archives.settings.archive_button"),
                       data: { confirm: t("guild_archives.settings.archive_confirm_prompt", guild_name: @guild.name) },
                       class: "px-6 py-3 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors font-semibold cursor-pointer" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="mt-6">
    <%= link_to t('guilds.settings.back_to_dashboard'), guild_path(@guild), class: "text-theme-accent hover:text-theme-accent-hover" %>
  </div>
</div>
