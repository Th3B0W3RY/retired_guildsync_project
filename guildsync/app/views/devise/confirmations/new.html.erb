<div class="max-w-md mx-auto" data-turbo="false">
  <h1 class="text-3xl font-bold text-theme-primary mb-4"><%= t("confirmations.new.title") %></h1>
  <p class="text-theme-secondary mb-8"><%= t("confirmations.new.intro") %></p>

  <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post, class: "space-y-6" }) do |f| %>
    <% if resource.errors.any? %>
      <div class="p-4 bg-red-900/50 border border-red-700 text-red-100 rounded-lg mb-4">
        <ul class="list-disc list-inside space-y-1">
          <% resource.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :email, t("common.labels.email"), class: "block mb-2 text-theme-secondary font-medium" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email),
          class: "w-full px-4 py-3 bg-theme-secondary border border-theme-primary rounded-lg text-theme-primary focus:outline-none focus:ring-2 focus:ring-theme-accent focus:border-transparent transition-all" %>
    </div>

    <div>
      <%= f.submit t("confirmations.new.submit"),
          class: "w-full px-4 py-3 bg-theme-accent text-white rounded-lg hover:bg-theme-accent-hover transition-colors cursor-pointer font-semibold text-lg shadow-lg" %>
    </div>
  <% end %>

  <div class="mt-8 pt-6 border-t border-theme-primary">
    <p class="text-theme-secondary text-center">
      <%= link_to t("confirmations.new.back_to_sign_in"), login_path, class: "text-theme-accent hover:text-dark-accent-hover font-medium underline" %>
    </p>
  </div>
</div>
