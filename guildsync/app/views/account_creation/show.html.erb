<div class="w-full max-w-[448px] font-[family-name:Inter,ui-sans-serif,system-ui,sans-serif]" data-turbo="false">
  <div class="rounded-2xl bg-[rgba(15,23,43,0.5)] shadow-[0px_25px_50px_-12px_rgba(0,0,0,0.25)] outline outline-1 outline-offset-[-1px] outline-[rgba(255,255,255,0.1)] pt-8 px-[33px] pb-8 flex flex-col gap-6">
    <div class="text-center">
      <h1 class="text-white text-2xl font-semibold leading-8"><%= t("account_creation.show.title") %></h1>
      <p class="mt-2 text-[#90A1B9] text-sm leading-5"><%= t("account_creation.show.subtitle") %></p>
    </div>

    <%= form_with url: create_account_path, method: :post, local: true, data: { turbo: false }, class: "flex flex-col gap-5" do |f| %>
      <div class="flex flex-col gap-1">
        <%= f.label :email, t("common.labels.email"), class: "text-[#CAD5E2] text-sm font-medium leading-5" %>
        <%= f.email_field :email, value: @email, required: true, autofocus: true, autocomplete: "email",
            class: "w-full h-9 px-3 rounded-lg bg-[rgba(29,41,61,0.5)] border border-[#314158] text-white text-sm placeholder:text-[#90A1B9] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#7C86FF]/90 focus-visible:border-transparent transition-shadow" %>
      </div>

      <% if turnstile_enforced? %>
        <div class="cf-turnstile" data-sitekey="<%= turnstile_site_key %>" data-theme="dark"></div>
      <% end %>

      <%= f.submit t("account_creation.show.submit"),
          class: "w-full h-11 rounded-lg bg-theme-brand-gradient text-white text-sm font-medium leading-5 cursor-pointer border-0 shadow-none hover:opacity-95 transition-opacity focus:outline-none focus-visible:ring-2 focus-visible:ring-white/40 focus-visible:ring-offset-2 focus-visible:ring-offset-[rgba(15,23,43,0.5)]" %>
    <% end %>

    <p class="text-center text-sm leading-5 text-[#90A1B9]">
      <%= t("account_creation.show.have_account") %>
      <%= link_to t("common.buttons.sign_in"), login_path(email_login: 1), class: "text-[#7C86FF] hover:opacity-90 transition-opacity" %>
    </p>
  </div>
</div>
