<%# Slim persistent “flash-style” pill to the right of Sign in; Discord #5865F2 per UI_OVERHAUL_MASTER_PROMPT.md %>
<div id="guest-beta-discord-banner"
     class="inline-flex max-w-full flex-wrap items-center justify-center gap-1.5 rounded-md border border-orange-300/45 bg-gradient-to-r from-[#EA580C] via-[#F97316] to-[#DC2626] px-2.5 py-0.5 shadow-[0_0_16px_-6px_rgba(234,88,12,0.45)] outline outline-1 outline-offset-[-1px] outline-white/10"
     role="status">
  <span class="inline-flex shrink-0 items-center text-amber-100" aria-hidden="true">
    <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
      <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
    </svg>
  </span>
  <span class="min-w-0 text-center text-[11px] font-semibold leading-tight text-white/95 sm:text-left sm:text-xs">
    <%= t("layouts.application.beta_banner.message") %>
  </span>
  <%= link_to t("layouts.application.beta_banner.join_discord"),
        community_discord_url,
        target: "_blank",
        rel: "noopener noreferrer",
        class: "inline-flex shrink-0 items-center justify-center rounded bg-[#5865F2] px-2 py-0.5 text-[11px] font-semibold text-white transition-colors hover:bg-[#4752C4] focus:outline-none focus-visible:ring-2 focus-visible:ring-white/50 sm:text-xs" %>
</div>
