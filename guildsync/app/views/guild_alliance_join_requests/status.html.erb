<div class="max-w-3xl mx-auto p-6 space-y-6">
  <div>
    <%= link_to t("alliances.outgoing_join_requests.new.back"), guild_path(@guild), class: "text-sm text-theme-accent hover:text-theme-accent-hover mb-4 inline-block" %>
    <h1 class="text-3xl font-bold text-theme-primary mb-2"><%= t("alliances.outgoing_join_requests.status.title") %></h1>
    <p class="text-theme-secondary"><%= t("alliances.outgoing_join_requests.status.subtitle", guild_name: @guild.name) %></p>
  </div>

  <div class="bg-theme-secondary rounded-lg border border-theme-primary p-6">
    <% if @outgoing.any? %>
      <ul class="space-y-3">
        <% @outgoing.each do |jr| %>
          <li class="text-theme-secondary border border-theme-primary rounded-lg p-4">
            <span class="font-medium text-theme-primary"><%= @guild.name %></span>
            → <%= jr.alliance.name %>
            <span class="text-xs text-theme-secondary ml-2">(<%= t("alliances.outgoing_join_requests.status.pending") %>)</span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-theme-secondary"><%= t("alliances.outgoing_join_requests.status.none") %></p>
    <% end %>
  </div>
</div>
