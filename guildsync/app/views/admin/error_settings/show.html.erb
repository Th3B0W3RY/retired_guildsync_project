<div class="space-y-6">
  <div class="flex justify-between items-center flex-wrap gap-4">
    <h1 class="text-3xl font-bold text-theme-accent"><%= t("admin.error_settings.show.page_title") %></h1>
    <%= link_to t("admin.error_settings.show.back_dashboard"), admin_root_path,
          class: "px-4 py-2 bg-theme-secondary text-theme-primary rounded-lg hover:bg-theme-hover transition-colors",
          data: { turbo_frame: "_top" } %>
  </div>

  <div id="admin_error_settings_flash" class="min-h-0" aria-live="polite"></div>

  <%= turbo_frame_tag Admin::ErrorSettingsController::ERROR_SETTINGS_MAIN_FRAME do %>
    <%= render "error_settings_main" %>
  <% end %>
</div>
