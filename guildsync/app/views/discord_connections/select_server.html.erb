<style>
  .server-select-container {
    max-width: 100%;
  }
  .header {
    text-align: center;
    margin-bottom: 32px;
    padding-bottom: 24px;
    border-bottom: 2px solid rgba(88, 101, 242, 0.3);
  }
  .header h1 {
    font-size: 28px;
    font-weight: 700;
    margin: 0 0 8px 0;
    color: #ffffff;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
  }
  .header p {
    font-size: 14px;
    color: #b0b0b0;
    margin: 0;
  }
  .server-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    max-height: calc(100vh - 200px);
    overflow-y: auto;
    overflow-x: hidden;
    padding-right: 8px;
    padding-bottom: 20px;
  }
  .server-list::-webkit-scrollbar {
    width: 8px;
  }
  .server-list::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
  }
  .server-list::-webkit-scrollbar-thumb {
    background: rgba(88, 101, 242, 0.5);
    border-radius: 4px;
  }
  .server-list::-webkit-scrollbar-thumb:hover {
    background: rgba(88, 101, 242, 0.7);
  }
  .server-card {
    background: linear-gradient(135deg, rgba(42, 42, 58, 0.8) 0%, rgba(30, 30, 45, 0.8) 100%);
    border: 2px solid rgba(88, 101, 242, 0.3);
    border-radius: 12px;
    padding: 20px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    align-items: center;
    gap: 16px;
    position: relative;
    overflow: hidden;
  }
  .server-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(88, 101, 242, 0.1) 0%, rgba(88, 101, 242, 0.05) 100%);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .server-card:hover {
    border-color: #5865F2;
    background: linear-gradient(135deg, rgba(88, 101, 242, 0.2) 0%, rgba(88, 101, 242, 0.1) 100%);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(88, 101, 242, 0.3);
  }
  .server-card:hover::before {
    opacity: 1;
  }
  .server-card:active {
    transform: translateY(0);
  }
  .server-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: linear-gradient(135deg, #5865F2 0%, #4752C4 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    font-weight: 700;
    color: #ffffff;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(88, 101, 242, 0.4);
  }
  .server-info {
    flex: 1;
    min-width: 0;
  }
  .server-name {
    font-size: 18px;
    font-weight: 600;
    color: #ffffff;
    margin: 0 0 6px 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .server-role {
    font-size: 13px;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 12px;
    margin: 0;
  }
  .server-role.owner {
    background: rgba(34, 197, 94, 0.2);
    color: #22c55e;
    border: 1px solid rgba(34, 197, 94, 0.3);
  }
  .server-role.admin {
    background: rgba(59, 130, 246, 0.2);
    color: #3b82f6;
    border: 1px solid rgba(59, 130, 246, 0.3);
  }
  .server-role::before {
    content: '✓';
    font-weight: 700;
  }
  .empty-state {
    text-align: center;
    padding: 48px 24px;
    background: rgba(42, 42, 58, 0.5);
    border: 2px dashed rgba(88, 101, 242, 0.3);
    border-radius: 12px;
  }
  .empty-state p {
    color: #b0b0b0;
    margin: 0 0 8px 0;
  }
  .empty-state .back-btn {
    display: inline-block;
    margin-top: 16px;
    padding: 10px 24px;
    background: #5865F2;
    color: #ffffff;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    transition: all 0.2s;
  }
  .empty-state .back-btn:hover {
    background: #4752C4;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(88, 101, 242, 0.4);
  }
</style>

<div class="max-w-4xl mx-auto p-6">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-theme-primary mb-2"><%= t('discord_connections.select_server.title') %></h1>
    <p class="text-theme-secondary"><%= t('discord_connections.select_server.subtitle') %></p>
  </div>
  
<div class="server-select-container">
  <div class="header">
    <h1><%= t('discord_connections.select_server.header') %></h1>
    <p><%= t('discord_connections.select_server.header_subtitle') %></p>
  </div>

  <% if @discord_guilds.any? %>
    <div class="server-list">
      <% @discord_guilds.each do |guild| %>
        <%= form_with url: connect_discord_server_path(@guild), method: :post, local: false, data: { turbo: false }, class: "server-form" do |f| %>
          <%= f.hidden_field :discord_guild_id, value: guild['id'] %>
          <div class="server-card" data-server-card role="button" tabindex="0">
            <div class="server-icon">
              <%= guild['name'][0].upcase %>
            </div>
            <div class="server-info">
              <h3 class="server-name"><%= guild['name'] %></h3>
              <p class="server-role <%= guild['owner'] ? 'owner' : 'admin' %>">
                <%= guild['owner'] ? t('discord_connections.select_server.role_owner') : t('discord_connections.select_server.role_admin') %>
              </p>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <p style="font-size: 16px; font-weight: 600; color: #ffffff; margin-bottom: 12px;"><%= t('discord_connections.select_server.empty_title') %></p>
      <p><%= t('discord_connections.select_server.empty_message') %></p>
      <a href="<%= guild_discord_connection_path(@guild) %>" class="back-btn"><%= t('discord_connections.select_server.go_back') %></a>
    </div>
  <% end %>
</div>

  <div class="mt-6">
    <%= link_to t('discord_connections.select_server.back_to_dashboard'), guild_discord_connection_path(@guild), class: "text-theme-accent hover:text-theme-accent-hover" %>
  </div>
</div>

<script>
  // Listen for bot authorization completion (always active on this page)
  var botAuthListener = function(event) {
    // Accept messages from any origin (Discord redirects may come from different origins)
    // Handle both message formats: { status: "authorized" } and { type: "DISCORD_BOT_AUTHORIZED", status: "authorized" }
    var isAuthorized = event.data && (
      event.data.status === "authorized" || 
      event.data.type === "DISCORD_BOT_AUTHORIZED" ||
      (event.data.type === "DISCORD_BOT_AUTHORIZED" && event.data.status === "authorized")
    );
    
    if (isAuthorized) {
      console.log('Bot authorization message received:', event.data);
      window.removeEventListener('message', botAuthListener);
      
      // Redirect to connection page to show bot is connected
      // Use a small delay to ensure popup closes first
      setTimeout(function() {
        window.location.href = '<%= guild_discord_connection_path(@guild) %>';
      }, 500);
    }
  };
  
  window.addEventListener('message', botAuthListener);
  
  // Handle server card clicks: always use fetch (never form submit) so we get JSON and open OAuth popup
  function openBotAuthPopup(botAuthUrl, serverName) {
    var width = 600;
    var height = 700;
    var left = Math.round((screen.width - width) / 2);
    var top = Math.round((screen.height - height) / 2);
    var popup = window.open(
      botAuthUrl,
      'GuildSyncBotAuth',
      'width=' + width + ',height=' + height + ',left=' + left + ',top=' + top + ',toolbar=no,location=no,status=no,menubar=no,scrollbars=yes,resizable=yes'
    );
    return popup;
  }

  function setCardsLoading(loading) {
    var cards = document.querySelectorAll('.server-card');
    cards.forEach(function(card) {
      card.style.opacity = loading ? '0.5' : '1';
      card.style.pointerEvents = loading ? 'none' : 'auto';
    });
  }

  function attachServerCardHandlers() {
    var csrfToken = document.querySelector('meta[name="csrf-token"]');
    var token = csrfToken ? csrfToken.content : '';

    // Click on server card: POST via fetch (never submit form) so server returns JSON
    document.removeEventListener('click', window._guildSyncServerCardClick);
    window._guildSyncServerCardClick = function(e) {
      var card = e.target && e.target.closest && e.target.closest('[data-server-card]');
      if (!card) return;
      var form = card.closest('form.server-form');
      if (!form || !form.action) return;
      e.preventDefault();
      e.stopPropagation();

      setCardsLoading(true);
      var formData = new FormData(form);

      fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: {
          'X-Requested-With': 'XMLHttpRequest',
          'Accept': 'application/json',
          'X-CSRF-Token': token
        },
        credentials: 'same-origin'
      })
      .then(function(response) {
        var contentType = response.headers.get('content-type') || '';
        var isJson = contentType.indexOf('application/json') !== -1;

        if (!response.ok) {
          if (isJson) {
            return response.json().then(function(data) {
              throw new Error(data.error || 'Something went wrong. Please try again.');
            });
          }
          return response.text().then(function() {
            throw new Error('Something went wrong. Please try again or refresh the page.');
          });
        }

        if (!isJson) {
          setCardsLoading(false);
          window.showToast('error', 'Unexpected response. Please refresh the page and try again.');
          return;
        }
        return response.json();
      })
      .then(function(data) {
        if (!data) return;
        if (data.error) {
          window.showToast('error', data.error);
          setCardsLoading(false);
          return;
        }
        if (data.bot_auth_url) {
          console.log('Opening bot authorization for:', data.server_name || 'Discord server');
          var popup = openBotAuthPopup(data.bot_auth_url, data.server_name);
          if (!popup || popup.closed || typeof popup.closed === 'undefined') {
            window.showToast('warning', '<%= j t('js.discord_connections.popup_blocked') %>');
          }
          setCardsLoading(false);
          var checkClosed = setInterval(function() {
            if (popup.closed) {
              clearInterval(checkClosed);
              setCardsLoading(false);
            }
          }, 500);
        } else {
          setCardsLoading(false);
        }
      })
      .catch(function(err) {
        console.error('Discord server select error:', err);
        setCardsLoading(false);
        window.showToast('error', err && err.message ? err.message : 'Something went wrong. Please try again.');
      });
    };
    document.addEventListener('click', window._guildSyncServerCardClick);

    // Keyboard: Enter/Space on card
    document.removeEventListener('keydown', window._guildSyncServerCardKeydown);
    window._guildSyncServerCardKeydown = function(e) {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      var card = e.target && e.target.closest && e.target.closest('[data-server-card]');
      if (!card) return;
      e.preventDefault();
      card.click();
    };
    document.addEventListener('keydown', window._guildSyncServerCardKeydown);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', attachServerCardHandlers);
  } else {
    attachServerCardHandlers();
  }
  document.addEventListener('turbo:load', attachServerCardHandlers);
</script>

