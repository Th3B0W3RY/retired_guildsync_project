<% sidebar_fixed = local_assigns.fetch(:sidebar_fixed, true) %>
<% sidebar_position_class = sidebar_fixed ? "fixed top-0 left-0 z-40 w-72" : "relative z-auto min-h-0 w-full" %>
<aside
  id="sidebar"
  class="<%= sidebar_position_class %> flex h-full min-h-0 select-none flex-col border-r border-white/5 bg-slate-950/80 font-[family-name:Inter,ui-sans-serif,system-ui,sans-serif] antialiased"
>
  <% if user_signed_in? %>
    <div class="flex min-h-0 flex-1 flex-col">
      <div class="flex min-h-0 flex-1 flex-col overflow-y-auto overscroll-contain px-4 pb-6 pt-4" data-controller="sidebar-scroll">
      <p class="text-sm font-semibold uppercase leading-5 tracking-wide text-slate-400"><%= t("sidebar.navigation") %></p>
      <p class="mt-4 text-xs font-medium uppercase leading-4 tracking-wide text-slate-400"><%= t("sidebar.universal_actions") %></p>

      <div class="mt-2" data-controller="guild-dropdown" data-guild-id="universal-menu">
        <button type="button"
                data-action="click->guild-dropdown#toggle"
                class="flex h-9 w-full items-center justify-between rounded-[10px] px-3 text-sm font-normal text-slate-300 transition-colors hover:bg-white/5"
                data-guild-dropdown-target="button">
          <span><%= t("sidebar.universal_menu") %></span>
          <svg class="h-4 w-4 shrink-0 text-white transition-transform" data-guild-dropdown-target="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>

        <div data-guild-dropdown-target="menu" class="mt-3 hidden space-y-2">
          <% discord_connected = current_user.discord_connected? %>
          <div class="rounded-[10px] border px-3 py-2.5 <%= discord_connected ? "border-green-500/30 bg-green-500/10" : "border-red-500/50 bg-red-500/5" %>" role="status" aria-label="<%= discord_connected ? t("sidebar.connected_as_aria", username: sidebar_discord_username_line(current_user)) : t("sidebar.discord_not_connected_heading") %>">
            <div class="flex items-start gap-2">
              <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full <%= discord_connected ? "bg-green-500" : "bg-red-500" %>" aria-hidden="true"></span>
              <div class="min-w-0 space-y-0.5">
                <% if discord_connected %>
                  <p class="truncate text-sm font-normal leading-5 text-green-400"><%= t("sidebar.connected_as", username: sidebar_discord_username_line(current_user)) %></p>
                <% else %>
                  <p class="text-xs font-medium leading-4 text-red-400"><%= t("sidebar.discord_not_connected_heading") %></p>
                  <p class="truncate text-sm font-normal leading-5 text-slate-400"><%= t("sidebar.discord_not_connected_hint") %></p>
                <% end %>
              </div>
            </div>
          </div>

          <div class="space-y-1">
            <%= link_to dashboard_path, class: sidebar_figma_universal_link(sidebar_global_dashboard_active?) do %>
              <svg class="h-5 w-5 shrink-0 opacity-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
              </svg>
              <span><%= t("sidebar.global_dashboard") %></span>
            <% end %>

            <%= link_to roadmap_path, class: sidebar_figma_universal_link(sidebar_feature_requests_active?) do %>
              <svg class="h-5 w-5 shrink-0 opacity-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
              </svg>
              <span><%= t("sidebar.feature_requests") %></span>
            <% end %>

            <% if (warn_guild = sidebar_target_guild_for_my_warnings).present? && warn_guild.persisted? %>
              <%= link_to guild_my_warnings_path(warn_guild), class: sidebar_figma_universal_link(sidebar_my_warnings_active?(warn_guild)) do %>
                <svg class="h-5 w-5 shrink-0 opacity-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M9 3h6l1 2h4v2H4V5h4l1-2zm-2 6h10v10a2 2 0 01-2 2H9a2 2 0 01-2-2V9z"></path>
                </svg>
                <span><%= t("sidebar.guild_menu.my_warnings") %></span>
              <% end %>
            <% end %>

            <%= link_to guild_applications_path, class: sidebar_figma_universal_link(sidebar_my_applications_active?) do %>
              <svg class="h-5 w-5 shrink-0 opacity-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              <span><%= t("sidebar.my_applications") %></span>
            <% end %>

            <%= link_to member_dashboard_path, class: sidebar_figma_universal_link(sidebar_member_guilds_active?) do %>
              <svg class="h-5 w-5 shrink-0 opacity-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
              </svg>
              <span><%= t("sidebar.view_guilds") %></span>
            <% end %>

            <%= link_to new_guild_application_path, class: sidebar_figma_universal_link(sidebar_apply_to_guild_active?) do %>
              <svg class="h-5 w-5 shrink-0 opacity-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              <span><%= t("sidebar.apply_to_guild") %></span>
            <% end %>

            <% if show_nav_create_guild?(current_user) %>
              <%= link_to new_guild_path, data: { turbo: false }, class: sidebar_figma_universal_link(sidebar_create_guild_active?) do %>
                <svg class="h-5 w-5 shrink-0 opacity-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                <span><%= t("sidebar.create_guild") %></span>
              <% end %>
            <% end %>

            <% if show_nav_archived_guilds?(current_user) %>
              <%= link_to guild_archives_path, class: sidebar_figma_universal_link(sidebar_archived_guilds_active?) do %>
                <svg class="h-5 w-5 shrink-0 opacity-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M8 8V6a4 4 0 118 0v2m-9 0v10a2 2 0 002 2h6a2 2 0 002-2V8"></path>
                </svg>
                <span><%= t("sidebar.archived_guilds") %></span>
              <% end %>
            <% end %>

            <% if show_alliances_top_nav?(current_user) %>
              <%= link_to alliances_path, class: sidebar_figma_universal_link(sidebar_alliances_hub_active?) do %>
                <svg class="h-5 w-5 shrink-0 opacity-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
                <span><%= t("sidebar.alliances_hub") %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>

        <div class="my-4 border-t border-white/5" aria-hidden="true"></div>

      <nav class="space-y-2">
        <!-- Guilds I Own: only non-archived owned guilds (hide until user has an active owned guild). -->
        <% active_owned_guilds = current_user.owned_guilds.not_archived %>
        <% if active_owned_guilds.any? %>
          <% owned_ids_for_alliance_nav = active_owned_guilds.map(&:id) %>
          <% pending_inv_by_guild = AllianceInvite.where(guild_id: owned_ids_for_alliance_nav, status: :pending).group(:guild_id).count %>
          <% outgoing_join_guild_ids = AllianceJoinRequest.where(requesting_guild_id: owned_ids_for_alliance_nav, status: :pending).distinct.pluck(:requesting_guild_id).to_set %>
          <div class="mb-4">
            <div class="mb-2 flex items-center justify-between">
              <h3 class="text-xs font-medium uppercase tracking-wide text-slate-400"><%= t("sidebar.my_guilds_owner") %></h3>
            </div>
            
            <!-- Dynamic Guild Dropdowns -->
            <% active_owned_guilds.each do |guild| %>
              <% next unless guild.persisted? && guild.id.present? %>
              <div class="mb-2" data-controller="guild-dropdown" data-guild-id="<%= guild.id %>">
                <button type="button"
                        data-action="click->guild-dropdown#toggle"
                        class="flex h-12 w-full items-center justify-between rounded-[10px] border border-indigo-400/30 bg-indigo-400/10 px-3 text-sm font-medium text-white transition-colors hover:bg-indigo-400/15"
                        data-guild-dropdown-target="button">
                  <div class="flex min-w-0 items-center gap-2">
                    <%= guild_sidebar_logo_tile(guild) %>
                    <span class="truncate font-medium"><%= guild.name %></span>
                  </div>
                  <svg class="w-4 h-4 transition-transform" data-guild-dropdown-target="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </button>
                
                <!-- Dropdown Menu -->
                <div data-guild-dropdown-target="menu" class="hidden ml-4 mt-1 space-y-1">
                  <%= link_to guild_path(guild), class: sidebar_figma_guild_sublink(sidebar_guild_dashboard_active?(guild)) do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                    </svg>
                    <span>Dashboard</span>
                  <% end %>

                  <% if guild.owner_id == current_user.id %>
                    <% if (pending_inv_by_guild[guild.id] || 0).positive? %>
                      <%= link_to guild_alliance_invites_pending_path(guild), class: "flex items-center gap-3 px-4 py-2 text-sm text-amber-400 hover:text-amber-300 hover:bg-theme-secondary rounded-lg transition-colors" do %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                        </svg>
                        <span><%= t("sidebar.alliance_menu.pending_alliance_invites") %></span>
                      <% end %>
                    <% end %>
                    <% if outgoing_join_guild_ids.include?(guild.id) %>
                      <%= link_to guild_alliance_join_status_path(guild), class: sidebar_figma_guild_sublink(false) do %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span><%= t("sidebar.alliance_menu.outgoing_join_request") %></span>
                      <% end %>
                    <% end %>
                    <% unless guild.alliance_guild&.active? %>
                      <%= link_to new_guild_alliance_join_request_path(guild), class: sidebar_figma_guild_sublink(false) do %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                        <span><%= t("sidebar.alliance_menu.request_join_alliance") %></span>
                      <% end %>
                    <% end %>
                  <% end %>

                  <%# Alliance menu (collapsible) %>
                  <% guild_alliance = guild.alliance %>
                  <% if guild_alliance&.active? %>
                    <details class="ml-1 group" data-details-id="alliance-<%= guild_alliance.id %>">
                      <summary class="flex items-center justify-between gap-2 px-4 py-2 text-sm text-theme-secondary hover:text-theme-accent hover:bg-theme-secondary rounded-lg transition-colors cursor-pointer list-none">
                        <span class="flex items-center gap-3">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>
                          </svg>
                          <span><%= guild_alliance.name %></span>
                        </span>
                        <svg class="w-3 h-3 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                      </summary>
                      <div class="ml-4 mt-1 space-y-1">
                        <%= link_to alliance_path(guild_alliance), class: "flex items-center gap-2 px-3 py-1.5 text-xs text-theme-secondary hover:text-theme-accent hover:bg-theme-secondary rounded-lg transition-colors" do %>
                          <span>Alliance Dashboard</span>
                        <% end %>
                      <%= link_to alliance_alliance_events_path(guild_alliance), class: "flex items-center gap-2 px-3 py-1.5 text-xs text-theme-secondary hover:text-theme-accent hover:bg-theme-secondary rounded-lg transition-colors" do %>
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                        <span><%= t('sidebar.alliance_menu.events') %></span>
                      <% end %>
                      <%= link_to alliance_alliance_polls_path(guild_alliance), class: "flex items-center gap-2 px-3 py-1.5 text-xs text-theme-secondary hover:text-theme-accent hover:bg-theme-secondary rounded-lg transition-colors" do %>
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span><%= t('sidebar.alliance_menu.polls') %></span>
                      <% end %>
                      <%= link_to alliance_alliance_loot_rolls_path(guild_alliance), class: "flex items-center gap-2 px-3 py-1.5 text-xs text-theme-secondary hover:text-theme-accent hover:bg-theme-secondary rounded-lg transition-colors" do %>
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                        </svg>
                        <span><%= t('sidebar.alliance_menu.rolls') %></span>
                      <% end %>
                      <%= link_to alliance_alliance_messages_path(guild_alliance), class: "flex items-center gap-2 px-3 py-1.5 text-xs text-theme-secondary hover:text-theme-accent hover:bg-theme-secondary rounded-lg transition-colors" do %>
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                        </svg>
                        <span><%= t('sidebar.alliance_menu.chat') %></span>
                      <% end %>
                      <% if guild.owner == current_user %>
                        <%= link_to alliance_alliance_messages_path(guild_alliance, type: "gm"), class: "flex items-center gap-2 px-3 py-1.5 text-xs text-yellow-400 hover:text-yellow-300 hover:bg-theme-secondary rounded-lg transition-colors" do %>
                          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                          </svg>
                          <span><%= t('sidebar.alliance_menu.gm_chat') %></span>
                        <% end %>
                      <% end %>
                      <% if guild_alliance.leader_user == current_user %>
                        <%= link_to edit_alliance_path(guild_alliance), class: "flex items-center gap-2 px-3 py-1.5 text-xs text-theme-secondary hover:text-theme-accent hover:bg-theme-secondary rounded-lg transition-colors" do %>
                          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                          </svg>
                          <span><%= t('sidebar.alliance_menu.settings') %></span>
                        <% end %>
                      <% end %>
                      <% can_jr = can_manage_alliance_actions?(guild_alliance) %>
                      <% if can_jr %>
                        <% jr_pending = guild_alliance.alliance_join_requests.pending_requests.count %>
                        <%= link_to alliance_alliance_join_requests_path(guild_alliance), class: "flex items-center gap-2 px-3 py-1.5 text-xs text-theme-secondary hover:text-theme-accent hover:bg-theme-secondary rounded-lg transition-colors" do %>
                          <span><%= t("sidebar.alliance_menu.join_requests") %><%= jr_pending.positive? ? " (#{jr_pending})" : "" %></span>
                        <% end %>
                      <% end %>
                      </div>
                    </details>
                  <% elsif guild.owner == current_user && plan_allows?(:alliance_hub) %>
                    <%= link_to new_alliance_path, class: sidebar_figma_guild_sublink(false) do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                      </svg>
                      <span><%= t('sidebar.alliance_menu.create') %></span>
                    <% end %>
                  <% end %>
                  <% if plan_allows?(:message_center) %>
                  <%= link_to guild_message_center_path(guild), class: sidebar_figma_guild_sublink(false) do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                    </svg>
                    <span><%= t('sidebar.guild_menu.message_center') %></span>
                  <% end %>
                  <% end %>
                  <% discord_setting = guild.guild_discord_setting %>
                  <% is_connected = discord_setting.present? %>
                  <% discord_server_name = guild.discord_server_display_name %>
                  
                  <div class="px-4 py-2 text-sm">
                    <% if is_connected %>
                      <%= link_to guild_discord_connection_path(guild), class: "flex items-center gap-2 text-theme-secondary hover:text-theme-accent hover:bg-theme-secondary rounded-lg transition-colors -mx-2 px-2 py-1" do %>
                        <svg class="w-4 h-4 fill-current text-green-500" viewBox="0 0 24 24">
