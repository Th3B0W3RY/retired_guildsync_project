<%# locals: (release_notes_url:) %>
<div class="bg-theme-card border border-theme-primary rounded-lg p-6 shadow-lg max-w-2xl">
  <p class="text-theme-secondary mb-4"><%= t("roadmap.admin.release_notes.description") %></p>

  <%= form_with url: admin_update_release_notes_settings_path, method: :patch, class: "space-y-4" do |f| %>
    <div>
      <label class="block text-sm font-medium text-theme-secondary mb-1"><%= t("roadmap.admin.release_notes.url_label") %></label>
      <%= f.url_field :release_notes_url, value: release_notes_url, required: true,
          placeholder: "https://example.com/release-notes",
          class: "w-full px-4 py-2 bg-theme-primary border border-theme-primary rounded-lg text-theme-primary placeholder-theme-secondary focus:outline-none focus:ring-2 focus:ring-theme-accent" %>
      <p class="text-xs text-theme-secondary mt-1"><%= t("roadmap.admin.release_notes.url_hint") %></p>
    </div>
    <div class="flex items-center gap-3">
      <%= f.submit t("roadmap.admin.release_notes.save"), class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-semibold cursor-pointer" %>
      <% if release_notes_url.present? %>
        <%= link_to t("roadmap.admin.release_notes.preview"), release_notes_url, target: "_blank", rel: "noopener noreferrer", class: "text-sm text-theme-accent hover:underline" %>
      <% end %>
    </div>
  <% end %>
</div>
