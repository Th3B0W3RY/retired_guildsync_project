<% frame = Admin::FeatureAbusersController::FEATURE_ABUSERS_RESULTS_FRAME %>

<div class="bg-theme-card border border-theme-primary rounded-lg overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="bg-theme-secondary border-b border-theme-primary">
        <tr>
          <th class="px-4 py-3 font-semibold text-theme-primary"><%= t("admin.feature_abusers.col_id") %></th>
          <th class="px-4 py-3 font-semibold text-theme-primary"><%= t("admin.feature_abusers.username") %></th>
          <th class="px-4 py-3 font-semibold text-theme-primary"><%= t("admin.feature_abusers.col_email") %></th>
          <th class="px-4 py-3 font-semibold text-theme-primary"><%= t("admin.feature_abusers.locked") %></th>
          <th class="px-4 py-3 font-semibold text-theme-primary"><%= t("admin.feature_abusers.active_warning") %></th>
          <th class="px-4 py-3 font-semibold text-theme-primary"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-theme-primary">
        <% @users.each do |user| %>
          <%= render "admin/feature_abusers/user_row", user: user %>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @users.empty? %>
    <p class="px-6 py-8 text-center text-theme-secondary"><%= t("admin.feature_abusers.empty") %></p>
  <% end %>
</div>

<% if @total_pages > 1 %>
  <div class="flex gap-2 items-center text-sm text-theme-secondary mt-4">
    <% if @current_page > 1 %>
      <%= link_to t("admin.feature_abusers.pagination_prev"), admin_feature_abusers_path(q: @q, filter: @filter, page: @current_page - 1), class: "text-theme-accent", data: { turbo_frame: frame } %>
    <% end %>
    <span><%= t("admin.feature_abusers.pagination_page", current: @current_page, total: @total_pages) %></span>
    <% if @current_page < @total_pages %>
      <%= link_to t("admin.feature_abusers.pagination_next"), admin_feature_abusers_path(q: @q, filter: @filter, page: @current_page + 1), class: "text-theme-accent", data: { turbo_frame: frame } %>
    <% end %>
  </div>
<% end %>
